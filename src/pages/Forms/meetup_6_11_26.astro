---
// ערב משחקים, חיבורים ומוסיקה – הרשמה ועדכון לפי טלפון
---
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0A7090" />
  <title>מנגנים שרים ביחד – ערב משחקים, חיבורים ומוסיקה</title>
  <meta property="og:title" content="מנגנים שרים ביחד – ערב משחקים, חיבורים ומוסיקה" />
  <meta property="og:description" content="ערב של חיבורים חדשים ומשחקים חווייתיים. נרשמים יחד עם +1, ומעדכנים מתי שרוצים." />
  <meta property="og:image" content="https://atroproject1.vercel.app/images/meetup_6_11_26.jpeg" />

  <style is:global>
    :root {
      --bg: #0A7090; --surface: #0D5F7A; --ink: #FFFFFF; --muted: #C6EEF5; --line: #2A8BA8;
      --sage: #FFD23F; --sage-ink: #2A2100; --gold: #FF7AB6; --gold-soft: #0B5770; --danger: #FFB4B4;
      --field: #13809F;
      --font: Arial, "Helvetica Neue", Helvetica, sans-serif;
      color-scheme: dark;
    }

    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 17px; line-height: 1.6; }
    .wrap { max-width: 640px; margin: 0 auto; padding: 0 20px 64px; }
    h1, h2 { font-family: var(--font); font-weight: 700; line-height: 1.1; margin: 0; }
    h1 { font-size: clamp(38px, 10vw, 60px); letter-spacing: -0.01em; }
    h2 { font-size: 30px; }
    h3 { font-size: 19px; margin: 28px 0 8px; }
    .muted { color: var(--muted); }

    .hero { padding: 48px 0 32px; }
    .subtitle { font-weight: 700; font-size: clamp(21px, 5vw, 28px); line-height: 1.25; margin: 10px 0 0; color: var(--sage); }
    .subtitle + .cover { margin: 20px 0 0; }
    .intro { font-size: 18px; margin: 24px 0 0; max-width: 32em; }
    .intro p { margin: 0 0 10px; }
    .fine { font-size: 15px; color: var(--muted); margin: 14px 0 0; max-width: 34em; }
    .fine b { color: var(--gold); }
    .cover { margin: 0 0 24px; border-radius: 14px; overflow: hidden; background: var(--surface); }
    .cover img { width: 100%; height: auto; display: block; }
    .cover.is-empty { aspect-ratio: 16 / 9; display: grid; place-items: center; border: 2px dashed var(--line); background: transparent; }
    .cover.is-empty::after { content: "כאן תופיע תמונה"; color: var(--muted); font-size: 16px; }
    .note { margin: 20px 0 0; padding: 14px 16px; border-inline-start: 3px solid var(--gold); background: var(--gold-soft); font-size: 16px; }
    .note b { color: var(--gold); }

    .btn { display: inline-block; font: inherit; font-weight: 700; padding: 12px 22px; border-radius: 999px; border: 2px solid var(--sage); background: transparent; color: var(--ink); text-decoration: none; cursor: pointer; }
    .btn-primary { background: var(--sage); color: var(--sage-ink); }
    .btn-danger { border-color: var(--danger); color: var(--danger); }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .btn:disabled { opacity: .55; cursor: progress; }
    :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }


    .join { padding-top: 40px; border-top: 1px solid var(--line); }
    .join > p { margin: 8px 0 20px; }
    .field { margin-bottom: 18px; }
    .field label, legend { display: block; font-weight: 700; margin-bottom: 6px; }
    input[type=text], input[type=tel], input[type=number], textarea { width: 100%; font: inherit; color: var(--ink); background: var(--field); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
    input[dir=ltr] { text-align: left; }
    input[type=number] { max-width: 8em; }
    textarea { min-height: 80px; resize: vertical; }
    input::placeholder, textarea::placeholder { color: var(--muted); }
    .row { display: flex; gap: 10px; align-items: stretch; }
    .row input { flex: 1; }
    .hint { font-size: 15px; color: var(--muted); margin: 6px 0 0; }
    .split { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12px; }

    fieldset { border: 0; padding: 0; margin: 0 0 18px; }
    .modes { display: grid; gap: 8px; }
    .modes label { display: flex; gap: 10px; align-items: center; justify-content: center; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; font-weight: 400; }
    .modes label:has(input:checked) { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
    .modes input { margin: 0; accent-color: var(--sage); }
    .modes.inline { grid-template-columns: repeat(2, 1fr); max-width: 18em; }

    .group { padding: 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); margin-bottom: 18px; }
    .group > legend, .group-title { font-size: 19px; font-weight: 700; margin: 0 0 4px; }
    .group-intro { font-size: 16px; color: var(--muted); margin: 0 0 16px; }

    .info { margin: 8px 0 22px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); font-size: 16px; }
    .info p { margin: 0 0 6px; }
    .info p:last-child { margin-bottom: 0; }
    .info b { color: var(--gold); }

    .msg { margin: 12px 0 0; min-height: 1.6em; }
    .msg.ok { color: var(--sage); }
    .msg.err { color: var(--danger); }
    .community { margin-top: 28px; font-size: 0.85em; color: var(--muted); }
    .community p { margin: 0 0 12px; }
    .community strong { color: var(--ink); }
    .community a { color: var(--sage); font-weight: 700; }

    @media (max-width: 420px) {
      .split { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header class="hero">
      <h1>מנגנים שרים ביחד</h1>
      <p class="subtitle">ערב משחקים, חיבורים ומוסיקה</p>
      <figure class="cover">
        <img src="/images/meetup_6_11_26.jpeg" alt="מנגנים שרים ביחד" onerror="this.parentElement.classList.add('is-empty'); this.remove();" />
      </figure>
      <div class="intro">
        <p>הערב מוקדש לחיבורים חדשים ולמשחקים חווייתיים שיגרמו לנו לשכוח מה השעה.</p>
      </div>
      <p class="note"><b>*</b> כדי להירשם לאירוע, אבקש מכל משתתף להזמין +1 (מהמין האחר).</p>
      <p class="fine"><b>*</b> בכל עת אפשר לחזור לטופס ולעדכן או לשנות את התשובות שלכם.</p>
    </header>

    <main>
      <section id="join" class="join" aria-labelledby="join-title">
        <h2 id="join-title">הרשמה ועדכון</h2>
        <p class="muted">מספר הטלפון הוא המזהה שלכם. נרשמתם כבר? הזינו אותו וטענו את הפרטים כדי לעדכן.</p>

        <form id="form" novalidate>
          <div class="field">
            <label for="phone">מספר טלפון</label>
            <div class="row">
              <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="050-0000000" required />
              <button type="button" id="loadBtn" class="btn">טעינת פרטים</button>
            </div>
            <p id="loadMsg" class="hint"></p>
          </div>

          <!-- פרטים אישיים -->
          <fieldset class="group">
            <legend>פרטים אישיים</legend>
            <p class="group-intro">כמה מילים עליכם, כדי שנכיר.</p>

            <div class="field">
              <label for="name">שם מלא</label>
              <input id="name" type="text" autocomplete="name" maxlength="80" required />
            </div>
            <div class="field">
              <label for="name_en">שם מלא באנגלית</label>
              <input id="name_en" type="text" dir="ltr" autocomplete="off" maxlength="80" placeholder="Full name" required />
            </div>
            <div class="split">
              <div class="field">
                <label for="age">גיל</label>
                <input id="age" type="number" inputmode="numeric" min="18" max="99" required />
              </div>
              <div class="field">
                <label for="city">עיר</label>
                <input id="city" type="text" autocomplete="address-level2" maxlength="60" required />
              </div>
            </div>
            <div class="field">
              <label for="occupation">עיסוק בחיים</label>
              <input id="occupation" type="text" maxlength="100" required />
            </div>
            <div class="field">
              <label for="hobby">תחביב</label>
              <input id="hobby" type="text" maxlength="100" required />
            </div>
            <div class="field" style="margin-bottom:0">
              <label for="why_join">למה תרצו להצטרף לערב?</label>
              <textarea id="why_join" maxlength="500" required></textarea>
            </div>
          </fieldset>

          <!-- +1 -->
          <fieldset class="group">
            <legend>את מי תזמינו איתכם?</legend>
            <p class="group-intro">פרטי ה‑+1 שמגיע איתכם.</p>

            <div class="split">
              <div class="field">
                <label for="guest_name">שם מלא</label>
                <input id="guest_name" type="text" maxlength="80" required />
              </div>
              <div class="field">
                <label for="guest_age">גיל</label>
                <input id="guest_age" type="number" inputmode="numeric" min="18" max="99" required />
              </div>
            </div>
            <div class="field">
              <label for="guest_how_know">מאיפה אתם מכירים?</label>
              <input id="guest_how_know" type="text" maxlength="200" required />
            </div>
            <div class="field" style="margin-bottom:0">
              <label for="guest_why">למה לדעתכם הוא/היא ייהנו בערב שלנו?</label>
              <textarea id="guest_why" maxlength="400" required></textarea>
            </div>
          </fieldset>

          <!-- פינת השראה -->
          <fieldset class="group">
            <legend>פינת השראה</legend>
            <p class="group-intro">מדי פעם ניתן את הבמה לאחד המשתתפים, שישתף אותנו בסיפור שלו. סיפור שייתן השראה לכולם. למשל: שינוי שעשיתם, או אירוע שהתמודדתם איתו ואתם גאים בעצמכם.</p>

            <div class="field" style="margin-bottom:0">
              <span class="group-title" style="display:block;font-size:17px;margin-bottom:6px">תרצו לשתף סיפור?</span>
              <div class="modes inline">
                <label><input type="radio" name="share_story" value="yes" /><span>כן</span></label>
                <label><input type="radio" name="share_story" value="no" /><span>לא</span></label>
              </div>
            </div>
            <div id="storyField" class="field" style="margin:14px 0 0" hidden>
              <label for="story_details">ספרו לנו קצת על הסיפור</label>
              <textarea id="story_details" maxlength="800"></textarea>
            </div>
          </fieldset>

          <div class="field">
            <label for="open_question">שאלה פתוחה <span class="muted">(לא חובה)</span></label>
            <textarea id="open_question" maxlength="800" placeholder="מקום לכתוב מה שבא לכם"></textarea>
          </div>

          <div class="info">
            <p><b>*</b> הערב בעלות של 50 ₪ לכיסוי הוצאות.</p>
            <p><b>*</b> כל משתתף יביא משהו טעים לשולחן משותף.</p>
            <p><b>*</b> בערב יהיה יין, בירה, וויסקי, ג'ין ושתייה קלה.</p>
          </div>

          <div class="actions">
            <button type="submit" id="saveBtn" class="btn btn-primary">שמירת ההרשמה</button>
            <button type="button" id="deleteBtn" class="btn btn-danger" hidden>מחיקת ההרשמה</button>
          </div>
          <p id="saveMsg" class="msg" role="status"></p>
        </form>

        <div class="community">
          <p><strong>מכירים את מנגנים שרים ביחד?</strong><br />
            אם לא, אפשר להצטרף לקבוצה:
            <a href="https://chat.whatsapp.com/ImcpNyO1goH1zLorpNDaBA" target="_blank" rel="noopener">לקבוצת הוואטסאפ</a></p>
          <p>כדי לראות אירועים קודמים, אפשר להציץ באינסטגרם שלי:
            <a href="https://www.instagram.com/ilan_lotvin" target="_blank" rel="noopener">ilan_lotvin@</a></p>
        </div>
      </section>

    </main>
  </div>

  <script is:inline>
    // ===== הגדרות – לעדכן אחרי פריסת ה-Apps Script החדש =====
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzUs1CeQC5EK_sE06ygSjVak_QrAqAr9QsVLibTdSRk-FKJF5J8iiC7VeQbeEhVvag/exec';
    // ==========================================================

    const FIELDS = ['name', 'name_en', 'age', 'city', 'occupation', 'hobby', 'why_join',
      'guest_name', 'guest_age', 'guest_how_know', 'guest_why', 'story_details', 'open_question'];
    const REQUIRED = [
      ['name', 'חסר שם מלא.'],
      ['name_en', 'חסר שם מלא באנגלית.'],
      ['age', 'חסר גיל.'],
      ['city', 'חסרה עיר.'],
      ['occupation', 'חסר עיסוק.'],
      ['hobby', 'חסר תחביב.'],
      ['why_join', 'ספרו למה תרצו להצטרף.'],
      ['guest_name', 'חסר שם ה‑+1.'],
      ['guest_age', 'חסר גיל ה‑+1.'],
      ['guest_how_know', 'ספרו מאיפה אתם מכירים.'],
      ['guest_why', 'ספרו למה ה‑+1 ייהנה בערב.']
    ];

    const $ = (id) => document.getElementById(id);
    const els = {
      form: $('form'), phone: $('phone'), loadBtn: $('loadBtn'), loadMsg: $('loadMsg'),
      storyField: $('storyField'), saveBtn: $('saveBtn'), saveMsg: $('saveMsg'), deleteBtn: $('deleteBtn')
    };
    let loadedPhone = '';

    // ---------- JSONP (קריאה ומחיקה) ----------
    function jsonp(params) {
      return new Promise((resolve, reject) => {
        const cb = 'cb_' + Date.now() + '_' + Math.floor(Math.random() * 1e6);
        const s = document.createElement('script');
        const timer = setTimeout(() => { cleanup(); reject(new Error('timeout')); }, 15000);
        function cleanup() { clearTimeout(timer); delete window[cb]; s.remove(); }
        window[cb] = (data) => { cleanup(); resolve(data); };
        s.onerror = () => { cleanup(); reject(new Error('network')); };
        s.src = SCRIPT_URL + '?' + new URLSearchParams({ ...params, callback: cb, t: Date.now() });
        document.head.appendChild(s);
      });
    }

    // ---------- POST (שמירה – טקסטים ארוכים לא נכנסים בבטחה ב-URL) ----------
    async function post(payload) {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), 20000);
      try {
        const r = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload), signal: ctrl.signal });
        return await r.json();
      } catch (e) {
        throw new Error(e.name === 'AbortError' ? 'timeout' : 'network');
      } finally {
        clearTimeout(timer);
      }
    }

    // ---------- helpers ----------
    function normPhone(v) {
      let d = String(v || '').replace(/\D/g, '');
      if (d.startsWith('972')) d = '0' + d.slice(3);
      return d;
    }
    const validPhone = (d) => /^0\d{8,9}$/.test(d);
    const validAge = (v) => /^\d{1,2}$/.test(v) && +v >= 18 && +v <= 99;
    function setMsg(el, text, kind) { el.textContent = text; el.className = el.id === 'saveMsg' ? 'msg ' + (kind || '') : 'hint'; }
    const radioVal = (name) => els.form.querySelector(`input[name=${name}]:checked`)?.value || '';
    const errText = (err) => err.message === 'timeout' ? 'אין תגובה מהשרת. נסו שוב.'
      : err.message === 'network' ? 'בעיית חיבור. נסו שוב.' : err.message;

    // ---------- form ----------
    function toggle() { els.storyField.hidden = radioVal('share_story') !== 'yes'; }

    function setRadio(name, value) {
      els.form.querySelectorAll(`input[name=${name}]`).forEach((r) => { r.checked = r.value === value; });
    }

    function fillForm(r) {
      FIELDS.forEach((k) => { $(k).value = r[k] ?? ''; });
      setRadio('share_story', r.share_story || '');
      toggle();
    }

    async function loadExisting(silent) {
      const phone = normPhone(els.phone.value);
      if (!validPhone(phone)) { if (!silent) setMsg(els.loadMsg, 'הזינו מספר טלפון תקין, למשל 0501234567.'); return; }
      els.loadBtn.disabled = true;
      setMsg(els.loadMsg, 'מחפשים הרשמה קיימת…');
      try {
        const res = await jsonp({ action: 'get', phone });
        if (!res.ok) throw new Error(res.error);
        loadedPhone = phone;
        if (res.found) {
          fillForm(res.record);
          els.saveBtn.textContent = 'עדכון ההרשמה';
          els.deleteBtn.hidden = false;
          setMsg(els.loadMsg, 'הפרטים נטענו. אפשר לשנות ולעדכן.');
        } else {
          els.saveBtn.textContent = 'שמירת ההרשמה';
          els.deleteBtn.hidden = true;
          setMsg(els.loadMsg, 'אין עדיין הרשמה עם המספר הזה. ממלאים ושומרים.');
        }
      } catch (e) {
        setMsg(els.loadMsg, 'הטעינה נכשלה. בדקו את החיבור ונסו שוב.');
      } finally {
        els.loadBtn.disabled = false;
      }
    }

    els.loadBtn.addEventListener('click', () => loadExisting(false));
    els.phone.addEventListener('blur', () => {
      const p = normPhone(els.phone.value);
      if (validPhone(p) && p !== loadedPhone) loadExisting(true);
    });
    els.form.addEventListener('change', (e) => { if (e.target.name === 'share_story') toggle(); });

    els.form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const phone = normPhone(els.phone.value);
      if (!validPhone(phone)) return setMsg(els.saveMsg, 'מספר הטלפון לא תקין.', 'err'), els.phone.focus();

      const data = {};
      FIELDS.forEach((k) => { data[k] = $(k).value.trim(); });
      data.share_story = radioVal('share_story');

      for (const [k, msg] of REQUIRED) {
        if (!data[k]) return setMsg(els.saveMsg, msg, 'err'), $(k).focus();
      }
      if (!/[A-Za-z]/.test(data.name_en)) return setMsg(els.saveMsg, 'כתבו את השם באותיות באנגלית.', 'err'), $('name_en').focus();
      if (!validAge(data.age)) return setMsg(els.saveMsg, 'הגיל צריך להיות בין 18 ל‑99.', 'err'), $('age').focus();
      if (!validAge(data.guest_age)) return setMsg(els.saveMsg, 'גיל ה‑+1 צריך להיות בין 18 ל‑99.', 'err'), $('guest_age').focus();
      if (!data.share_story) return setMsg(els.saveMsg, 'בחרו אם תרצו לשתף סיפור.', 'err');
      if (data.share_story === 'yes' && !data.story_details) return setMsg(els.saveMsg, 'ספרו לנו קצת על הסיפור.', 'err'), $('story_details').focus();
      if (data.share_story === 'no') data.story_details = '';

      els.saveBtn.disabled = true;
      setMsg(els.saveMsg, 'שומרים…');
      try {
        const res = await post({ action: 'save', phone, ...data });
        if (!res.ok) throw new Error(res.error);
        try { localStorage.setItem('meetup_6_11_26_phone', phone); } catch {}
        loadedPhone = phone;
        els.saveBtn.textContent = 'עדכון ההרשמה';
        els.deleteBtn.hidden = false;
        setMsg(els.saveMsg, (res.status === 'updated' ? 'ההרשמה עודכנה.' : 'ההרשמה נשמרה.') +
          ' אפשר לחזור ולעדכן בכל זמן עם אותו מספר טלפון.', 'ok');
      } catch (err) {
        setMsg(els.saveMsg, 'השמירה נכשלה: ' + errText(err), 'err');
      } finally {
        els.saveBtn.disabled = false;
      }
    });

    els.deleteBtn.addEventListener('click', async () => {
      const phone = normPhone(els.phone.value);
      if (!validPhone(phone)) return setMsg(els.saveMsg, 'מספר הטלפון לא תקין.', 'err');
      if (!confirm('למחוק את ההרשמה שלכם? כל הפרטים יימחקו.')) return;

      els.deleteBtn.disabled = true; els.saveBtn.disabled = true;
      setMsg(els.saveMsg, 'מוחקים…');
      try {
        const res = await jsonp({ action: 'delete', phone });
        if (!res.ok) throw new Error(res.error);
        els.form.reset();
        loadedPhone = '';
        try { localStorage.removeItem('meetup_6_11_26_phone'); } catch {}
        els.saveBtn.textContent = 'שמירת ההרשמה';
        els.deleteBtn.hidden = true;
        setMsg(els.loadMsg, '');
        toggle();
        setMsg(els.saveMsg, res.status === 'deleted'
          ? 'ההרשמה נמחקה. אם תשנו את דעתכם, אפשר להירשם מחדש בכל זמן.'
          : 'לא נמצאה הרשמה עם המספר הזה.', 'ok');
      } catch (err) {
        setMsg(els.saveMsg, 'המחיקה נכשלה: ' + errText(err), 'err');
      } finally {
        els.deleteBtn.disabled = false; els.saveBtn.disabled = false;
      }
    });

    // ---------- init ----------
    toggle();
    try {
      const saved = localStorage.getItem('meetup_6_11_26_phone');
