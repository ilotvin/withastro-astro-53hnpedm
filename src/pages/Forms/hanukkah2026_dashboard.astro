/**
 * Apps Script – ריטריט חנוכה 2026 (מנגנים שרים ביחד)
 * גיליון: https://docs.google.com/spreadsheets/d/1Os77ieMxxzK3RfuM-MRJgKf-OLVuJ2WfLcp65hOLiUk
 *
 * פעולות:
 *   GET  ?action=status&callback=cb         (JSONP)  בדיקת מכסה ופופ-אפ בפתיחת הטופס
 *   GET  ?action=get&phone=...&callback=cb   (JSONP)  טעינת הרשמה קיימת + קניות + ספירת שורות + מכסה
 *   GET  ?action=delete&phone=...&callback=cb (JSONP)  מחיקת הרשמה + ספירת שורות
 *   GET  ?action=stats&phone=...&callback=cb  (JSONP)  נתונים מסוכמים + רשימת נרשמים לדשבורד – רק ל-OWNER_PHONE
 *   GET  ?action=ping                                  בדיקת חיבור
 *   POST {action:"save", data:{...}}                   שמירה / עדכון הרשמה לפי טלפון (כולל סימון waitlist_popup)
 *   POST {action:"waitlist", data:{phone,name,notes}}  שמירה בלשונית Registrations עם status = "רשימת המתנה"
 *   POST {action:"set_capacity", phone, capacity}      עדכון מכסת שורות מלאות ב-PropertiesService – רק ל-OWNER_PHONE
 *   POST {action:"purchase", phone, amount, store, details, file:{name,mime,b64}}
 *   POST {action:"approve", phone(owner), target, resend?}   אישור משתתף + שליחת מייל – רק ל-OWNER_PHONE
 */

var SCRIPT_VERSION = 'V14';

var OWNER_PHONE = '0546655862';
var REG_SHEET = 'Registrations';
var BUY_SHEET = 'Purchases';
var RECEIPTS_FOLDER = 'קבלות ריטריט חנוכה 2026';
var DEFAULT_CAPACITY = 25;

var REG_HEADERS = [
  'created', 'updated', 'phone', 'name', 'email',
  'attendance', 'extra_night', 'lodging',
  'age', 'gender', 'why', 'prev_retreats', 'prev_feedback', 'social',
  'car', 'area',
  'wine', 'baking',
  'two_facts', 'connect_ideas', 'workshop', 'story', 'content_details',
  'diet', 'gluten', 'allergies', 'kashrut', 'milk',
  'payment',
  'price_stage', 'price_total',
  'buyer', 'show',
  'status',
  'waitlist_popup',
  'email_sent'
];

var ACT_COLS = [
  ['act_dance', 'שיעור ריקוד'], ['act_yoga', 'יוגה'], ['act_acro_yoga', 'אקרו-יוגה'],
  ['act_painting', 'ציור'], ['act_craft', 'יצירה'], ['act_cyber', 'הרצאת סייבר'],
  ['act_nutrition', 'תזונה ואורח חיים'], ['act_public_speaking', 'דיבור מול קהל'],
  ['act_improv', 'אימפרוביזציה'], ['act_hike', 'מסלול הליכה']
];
var ROLE_COLS = [
  ['role_kitchen_chef', 'מנהל מטבח + שף'], ['role_shopping', 'קניות'], ['role_meat_wine_grill', 'בשרים, יינות ומנגל']
];
ACT_COLS.concat(ROLE_COLS).forEach(function (c) { REG_HEADERS.push(c[0]); });

var BUY_HEADERS = ['created', 'phone', 'name', 'amount', 'store', 'details', 'receipt_url', 'receipt_name'];
var PROTECTED = ['created', 'updated', 'phone', 'price_stage', 'price_total', 'buyer', 'show', 'status', 'email_sent'];

// ===== מייל אישור =====
var APPROVED_STATUS = 'מאושר';
var MAIL_FROM_NAME = 'מנגנים שרים ביחד';
var FORM_URL = 'https://atroproject1.vercel.app/Forms/hanukkah2026';
var PAYBOX_URL = 'https://links.payboxapp.com/aFmrkV1Gd8b';
var BANK = { bank: 'בנק דיסקונט (11)', branch: '055', account: '123562637', owner: 'אילן לוטווין' };
var DEPOSIT = 100; // מקדמה לשריון מקום


var PRICES = { y: { full: [350, 400, 450], one: [290, 340, 390] },
               n: { full: [200, 250, 300], one: [140, 190, 240] } };
var FOOD = { full: 200, one: 100 };
var WINE = 90;
var STAGE2 = new Date(2026, 10, 27); // 27.11.2026
var STAGE3 = new Date(2026, 11, 3);  // 3.12.2026
var STAGE_NAMES = ['הרשמה מוקדמת', 'שלב שני', 'שלב אחרון'];

/* ---------- התקנה: להריץ פעם אחת ידנית ---------- */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  ensureSheet_(ss, BUY_SHEET, BUY_HEADERS);
  getFolder_();
  getCapacity_();
}

/* ---------- מכסה (PropertiesService – ללא גיליון נוסף) ---------- */
function getCapacity_() {
  var raw = PropertiesService.getScriptProperties().getProperty('CAPACITY');
  var n = parseInt(raw, 10);
  return isFinite(n) && n >= 0 ? n : DEFAULT_CAPACITY;
}

function setCapacity_(rawPhone, rawCap) {
  if (normPhone_(rawPhone) !== OWNER_PHONE) throw new Error('unauthorized');
  var cap = parseInt(rawCap, 10);
  if (!isFinite(cap) || cap < 0) throw new Error('bad capacity');
  PropertiesService.getScriptProperties().setProperty('CAPACITY', String(cap));
  return { ok: true, capacity: cap };
}

/* ---------- GET (JSONP) ---------- */
function doGet(e) {
  var p = (e && e.parameter) || {};
  var out;
  try {
    if (p.action === 'ping') {
      out = { ok: true, version: SCRIPT_VERSION };
    } else if (p.action === 'status') {
      var ss = SpreadsheetApp.getActiveSpreadsheet();
      var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
      var count = getRegistrationCount_(sh);
      var capacity = getCapacity_();
      out = { ok: true, count: count, capacity: capacity, isFull: capacity > 0 && count >= capacity };
    } else if (p.action === 'get') {
      out = getRegistration_(p.phone);
    } else if (p.action === 'delete') {
      out = deleteRegistration_(p.phone);
    } else if (p.action === 'stats') {
      if (normPhone_(p.phone) !== OWNER_PHONE) throw new Error('unauthorized');
      out = getStats_();
    } else {
      throw new Error('unknown action');
    }
  } catch (err) {
    out = { ok: false, error: String(err.message || err) };
  }
  return respond_(out, p.callback);
}

/* ---------- POST ---------- */
function doPost(e) {
  var out;
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(20000);
    var body = JSON.parse((e && e.postData && e.postData.contents) || '{}');
    if (body.action === 'save') {
      out = saveRegistration_(body.data || {});
    } else if (body.action === 'waitlist') {
      out = saveWaitlist_(body.data || {});
    } else if (body.action === 'set_capacity') {
      out = setCapacity_(body.phone, body.capacity);
    } else if (body.action === 'purchase') {
      out = savePurchase_(body);
    } else if (body.action === 'approve') {
      out = approve_(body);
    } else {
      throw new Error('unknown action');
    }
  } catch (err) {
    out = { ok: false, error: String(err.message || err) };
  } finally {
    try { lock.releaseLock(); } catch (x) {}
  }
  return respond_(out);
}

function getRegistrationCount_(sh) {
  var last = sh.getLastRow();
  if (last < 2) return 0;
  var headers = getHeaders_(sh);
  var pi = headers.indexOf('phone');
  var si = headers.indexOf('status');
  if (pi < 0) return Math.max(0, last - 1);
  var vals = sh.getRange(2, pi + 1, last - 1, 1).getValues();
  var statusVals = si >= 0 ? sh.getRange(2, si + 1, last - 1, 1).getValues() : null;
  return vals.filter(function (r, idx) {
    if (!normPhone_(r[0])) return false;
    if (statusVals && String(statusVals[idx][0] || '').trim() === 'רשימת המתנה') return false;
    return true;
  }).length;
}

/* ---------- הרשמה ---------- */
function getRegistration_(rawPhone) {
  var phone = normPhone_(rawPhone);
  if (!phone) throw new Error('bad phone');
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var count = getRegistrationCount_(sh);
  var capacity = getCapacity_();
  var isFull = capacity > 0 && count >= capacity;
  var hit = findRow_(sh, phone);
  var owner = phone === OWNER_PHONE;
  if (!hit) {
    return { ok: true, found: false, owner: owner, count: count, capacity: capacity, isFull: isFull };
  }

  var data = hit.obj;
  var isBuyer = /^(כן|yes|true|1|v|✓)$/i.test(String(data.buyer || '').trim());
  var clean = {};
  Object.keys(data).forEach(function (k) {
    if (k === 'show' || k === 'buyer') return;
    clean[k] = data[k] instanceof Date ? data[k].toISOString() : data[k];
  });
  clean.activities = readFlags_(data, ACT_COLS) || String(data.activities || '');
  clean.helper_roles = readFlags_(data, ROLE_COLS) || String(data.helper_roles || '');
  return {
    ok: true,
    found: true,
    owner: owner,
    count: count,
    capacity: capacity,
    isFull: isFull,
    data: clean,
    buyer: isBuyer,
    purchases: isBuyer ? listPurchases_(ss, phone) : []
  };
}

function saveRegistration_(data) {
  var phone = normPhone_(data.phone);
  if (!phone) throw new Error('bad phone');
  if (!String(data.name || '').trim()) throw new Error('missing name');

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var headers = getHeaders_(sh);
  var hit = findRow_(sh, phone);
  var now = new Date();
  var created = hit && hit.obj.created instanceof Date ? hit.obj.created : now;

  var countBefore = getRegistrationCount_(sh);
  var capacity = getCapacity_();
  var currentlyFull = capacity > 0 && countBefore >= capacity;
  var fromPopup = String(data.waitlist_popup || '').trim() === 'כן' || (!hit && currentlyFull);

  var row = hit ? headers.map(function (h) { return hit.obj[h]; }) : headers.map(function () { return ''; });
  headers.forEach(function (h, i) {
    if (PROTECTED.indexOf(h) >= 0) return;
    if (data.hasOwnProperty(h)) {
      var v = data[h];
      row[i] = Array.isArray(v) ? v.join(', ') : String(v == null ? '' : v);
    }
  });

  writeFlags_(row, headers, ACT_COLS, data.activities);
  writeFlags_(row, headers, ROLE_COLS, data.helper_roles);

  var stage = stageFor_(created);
  var total = priceFor_(data, stage);
  var existingStatus = hit ? String(hit.obj.status || '').trim() : '';
  var finalStatus = hit
    ? (existingStatus || (fromPopup ? 'רשימת המתנה' : 'רשום'))
    : (fromPopup ? 'רשימת המתנה' : 'רשום');

  setCol_(row, headers, 'created', created);
  setCol_(row, headers, 'updated', now);
  setCol_(row, headers, 'phone', "'" + phone);
  setCol_(row, headers, 'price_stage', STAGE_NAMES[stage]);
  setCol_(row, headers, 'price_total', total == null ? '' : total);
  setCol_(row, headers, 'status', finalStatus);
  setCol_(row, headers, 'waitlist_popup', fromPopup || (hit && String(hit.obj.waitlist_popup || '').trim() === 'כן') ? 'כן' : '');

  if (hit) {
    sh.getRange(hit.row, 1, 1, headers.length).setValues([row]);
  } else {
    sh.appendRow(row);
  }
  var count = getRegistrationCount_(sh);
  return {
    ok: true,
    isNew: !hit,
    stage: stage,
    total: total,
    status: finalStatus,
    waitlistPopup: fromPopup,
    created: created.toISOString(),
    count: count,
    capacity: capacity,
    isFull: capacity > 0 && count >= capacity
  };
}

/* ---------- רשימת המתנה (באותו גיליון Registrations) ---------- */
function saveWaitlist_(data) {
  var phone = normPhone_(data.phone);
  if (!phone) throw new Error('bad phone');
  var name = String(data.name || '').trim();
  if (!name) throw new Error('missing name');
  var notes = String(data.notes || '').trim();

  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var headers = getHeaders_(sh);
  var hit = findRow_(sh, phone);
  var now = new Date();
  var created = hit && hit.obj.created instanceof Date ? hit.obj.created : now;

  var row = hit ? headers.map(function (h) { return hit.obj[h]; }) : headers.map(function () { return ''; });
  setCol_(row, headers, 'created', created);
  setCol_(row, headers, 'updated', now);
  setCol_(row, headers, 'phone', "'" + phone);
  setCol_(row, headers, 'name', name);
  setCol_(row, headers, 'status', 'רשימת המתנה');
  setCol_(row, headers, 'waitlist_popup', 'כן');
  if (notes) {
    var curWhy = String(hit && hit.obj.why ? hit.obj.why : '').trim();
    var noteLine = 'רשימת המתנה: ' + notes;
    setCol_(row, headers, 'why', curWhy ? (curWhy.indexOf(noteLine) >= 0 ? curWhy : curWhy + ' | ' + noteLine) : noteLine);
  }

  if (hit) {
    sh.getRange(hit.row, 1, 1, headers.length).setValues([row]);
  } else {
    sh.appendRow(row);
  }
  return { ok: true, updated: !!hit, status: 'רשימת המתנה' };
}

function deleteRegistration_(rawPhone) {
  var phone = normPhone_(rawPhone);
  if (!phone) throw new Error('bad phone');
  var lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    var sh = ensureSheet_(SpreadsheetApp.getActiveSpreadsheet(), REG_SHEET, REG_HEADERS);
    var hit = findRow_(sh, phone);
    if (!hit) return { ok: true, status: 'not_found', count: getRegistrationCount_(sh) };
    sh.deleteRow(hit.row);
    return { ok: true, status: 'deleted', count: getRegistrationCount_(sh) };
  } finally {
    lock.releaseLock();
  }
}

/* ---------- דשבורד ---------- */
function getStats_() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var last = sh.getLastRow();
  var headers = getHeaders_(sh);
  var allValidRows = last < 2 ? [] : sh.getRange(2, 1, last - 1, headers.length).getValues().map(function (r) {
    var o = {}; headers.forEach(function (h, i) { o[h] = r[i]; }); return o;
  }).filter(function (o) {
    return normPhone_(o.phone);
  });

  var rows = allValidRows.filter(function (o) {
    return String(o.status || '').trim() !== 'רשימת המתנה';
  });

  function tally(key, options) {
    var t = {}; options.forEach(function (k) { t[k] = 0; }); t['לא צוין'] = 0;
    rows.forEach(function (o) {
      var v = String(o[key] || '').trim();
      if (t.hasOwnProperty(v)) t[v]++; else if (!v) t['לא צוין']++; else t[v] = (t[v] || 0) + 1;
    });
    return t;
  }
  function avgAge(filter) {
    var ages = rows.filter(filter).map(function (o) { return parseFloat(o.age); })
      .filter(function (n) { return n >= 18 && n <= 99; });
    if (!ages.length) return null;
    return Math.round(ages.reduce(function (a, b) { return a + b; }, 0) / ages.length * 10) / 10;
  }
  function flags(cols) {
    return cols.map(function (c) {
      var n = rows.filter(function (o) {
        return String(o[c[0]] || '').trim() === 'כן' ||
          (!o.hasOwnProperty(c[0]) && String(o.activities || o.helper_roles || '').indexOf(c[1]) >= 0);
      }).length;
      return { label: c[1], count: n };
    }).sort(function (a, b) { return b.count - a.count; });
  }
  var FULL = 'סופ"ש מלא (חמישי–שבת)', FRI = 'שישי–שבת', THU = 'חמישי–שישי';
  function night(att) {
    var inVenue = 0, self = 0;
    rows.forEach(function (o) {
      if (att.indexOf(String(o.attendance || '')) < 0) return;
      if (String(o.lodging || '').indexOf('במתחם') >= 0) inVenue++; else self++;
    });
    return { venue: inVenue, self: self };
  }

  var registrants = allValidRows.map(function (o, idx) {
    var rec = {};
    headers.forEach(function (h) {
      var val = o[h];
      rec[h] = val instanceof Date ? val.toISOString() : val;
    });
    rec.phone = normPhone_(o.phone);
    rec.activities = readFlags_(o, ACT_COLS) || String(o.activities || '');
    rec.helper_roles = readFlags_(o, ROLE_COLS) || String(o.helper_roles || '');
    var baseName = String(o.name || '').trim() || ('משתתף ' + (idx + 1));
    var isWait = String(o.status || '').trim() === 'רשימת המתנה' || String(o.waitlist_popup || '').trim() === 'כן';
    rec.name = isWait ? (baseName + ' [המתנה]') : baseName;
    return rec;
  });

  return {
    ok: true,
    updated: new Date().toISOString(),
    capacity: getCapacity_(),
    total: rows.length,
    gender: tally('gender', ['גבר', 'אישה']),
    age: {
      all: avgAge(function () { return true; }),
      male: avgAge(function (o) { return o.gender === 'גבר'; }),
      female: avgAge(function (o) { return o.gender === 'אישה'; })
    },
    attendance: tally('attendance', [FULL, FRI, THU]),
    lodging: tally('lodging', ['לינה במתחם (מזרנים על פרקט)', 'לינה עצמאית (מלון / B&B)']),
    nights: { thu: night([FULL, THU]), fri: night([FULL, FRI]) },
    extraNight: tally('extra_night', ['כן', 'אולי', 'לא']),
    wine: rows.filter(function (o) { return String(o.wine || '') === 'כן'; }).length,
    activities: flags(ACT_COLS),
    roles: flags(ROLE_COLS),
    registrants: registrants
  };
}

/* ---------- אישור משתתף + מייל ---------- */
function approve_(b) {
  if (normPhone_(b.phone) !== OWNER_PHONE) throw new Error('unauthorized');
  var target = normPhone_(b.target);
  if (!target) throw new Error('bad phone');
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var headers = getHeaders_(sh);
  var hit = findRow_(sh, target);
  if (!hit) throw new Error('not found');
  var o = hit.obj;

  setCell_(sh, hit.row, headers, 'status', APPROVED_STATUS);
  setCell_(sh, hit.row, headers, 'updated', new Date());

  var email = String(o.email || '').trim();
  var already = String(o.email_sent || '').trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return { ok: true, status: APPROVED_STATUS, emailSent: false, reason: 'no email' };
  }
  if (already && !b.resend) {
    return { ok: true, status: APPROVED_STATUS, emailSent: false, reason: 'already sent', email_sent: already };
  }

  MailApp.sendEmail({
    to: email,
    subject: 'ההרשמה שלך לריטריט חנוכה אושרה 🎉',
    htmlBody: approvalHtml_(o),
    name: MAIL_FROM_NAME
  });
  var stamp = Utilities.formatDate(new Date(), 'Asia/Jerusalem', 'dd/MM/yy HH:mm');
  setCell_(sh, hit.row, headers, 'email_sent', stamp);
  return { ok: true, status: APPROVED_STATUS, emailSent: true, email_sent: stamp };
}

function approvalHtml_(o) {
  var e = function (v) { return String(v == null ? '' : v).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
  var name = String(o.name || '').trim().split(/\s+/)[0] || '';
  var price = o.price_total ? e(o.price_total) + ' ₪' + (o.price_stage ? ' (' + e(o.price_stage) + ')' : '') : '';
  var lines = [
    '<p>היי ' + e(name) + ',</p>',
    '<p><b>ההרשמה שלך לריטריט חנוכה אושרה!</b> שמחים שאת/ה איתנו 🤍</p>',
    '<p>📅 10–12 בדצמבר 2026 (חמישי–שבת)<br>📍 מתחם פעימה, מצפה רמון</p>',
    '<p>מתי מגיעים: ' + e(o.attendance) + '<br>לינה: ' + e(o.lodging) + '</p>'
  ];
  if (price) lines.push('<p>סכום לתשלום: <b>' + price + '</b>' + (o.payment ? '<br>אמצעי תשלום: ' + e(o.payment) : '') + '</p>');
  lines.push(
    '<p><b>💳 תשלום</b><br>' +
    'ניתן להעביר מקדמה של ' + DEPOSIT + ' ₪ לשריון מקום, ואת היתרה בהמשך.</p>' +
    '<p><b>פייבוקס:</b> <a href="' + PAYBOX_URL + '">לתשלום בפייבוקס</a></p>' +
    '<p><b>למעדיפים העברה בנקאית:</b><br>' +
    e(BANK.bank) + '<br>סניף ' + e(BANK.branch) + '<br>מספר חשבון ' + e(BANK.account) + '<br>על שם ' + e(BANK.owner) + '</p>'
  );
  lines.push('<p>אפשר לעדכן פרטים בכל זמן עם מספר הטלפון שלך: <a href="' + FORM_URL + '">לטופס</a></p>');
  lines.push('<p>נתראה במדבר,<br>מנגנים שרים ביחד</p>');
  return '<div dir="rtl" style="font-family:Arial,sans-serif;font-size:15px;line-height:1.6">' + lines.join('') + '</div>';
}

function setCell_(sh, row, headers, name, val) {
  var i = headers.lastIndexOf(name);
  if (i >= 0) sh.getRange(row, i + 1).setValue(val);
}

/* ---------- קניות ---------- */
function savePurchase_(b) {
  var phone = normPhone_(b.phone);
  if (!phone) throw new Error('bad phone');
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var reg = ensureSheet_(ss, REG_SHEET, REG_HEADERS);
  var hit = findRow_(reg, phone);
  if (!hit) throw new Error('not registered');
  if (!/^(כן|yes|true|1|v|✓)$/i.test(String(hit.obj.buyer || '').trim())) throw new Error('not a buyer');

  var amount = parseFloat(String(b.amount || '').replace(/[^\d.]/g, ''));
  if (!(amount > 0)) throw new Error('bad amount');

  var url = '', fname = '';
  if (b.file && b.file.b64) {
    var blob = Utilities.newBlob(Utilities.base64Decode(b.file.b64),
      b.file.mime || 'application/octet-stream',
      Utilities.formatDate(new Date(), 'Asia/Jerusalem', 'yyyyMMdd_HHmm') + '_' + phone + '_' + (b.file.name || 'receipt'));
    var f = getFolder_().createFile(blob);
    url = f.getUrl();
    fname = f.getName();
  }

  var sh = ensureSheet_(ss, BUY_SHEET, BUY_HEADERS);
  var headers = getHeaders_(sh);
  var row = headers.map(function () { return ''; });
  setCol_(row, headers, 'created', new Date());
  setCol_(row, headers, 'phone', "'" + phone);
  setCol_(row, headers, 'name', hit.obj.name || '');
  setCol_(row, headers, 'amount', amount);
  setCol_(row, headers, 'store', String(b.store || ''));
  setCol_(row, headers, 'details', String(b.details || ''));
  setCol_(row, headers, 'receipt_url', url);
  setCol_(row, headers, 'receipt_name', fname);
  sh.appendRow(row);

  return { ok: true, purchases: listPurchases_(ss, phone) };
}

function listPurchases_(ss, phone) {
  var sh = ensureSheet_(ss, BUY_SHEET, BUY_HEADERS);
  var last = sh.getLastRow();
  if (last < 2) return [];
  var headers = getHeaders_(sh);
  var vals = sh.getRange(2, 1, last - 1, headers.length).getValues();
  var pi = headers.indexOf('phone');
  return vals.filter(function (r) { return normPhone_(r[pi]) === phone; }).map(function (r) {
    var o = {};
    headers.forEach(function (h, i) { o[h] = r[i] instanceof Date ? r[i].toISOString() : r[i]; });
    return { created: o.created, amount: o.amount, store: o.store, details: o.details, hasReceipt: !!o.receipt_url };
  });
}

/* ---------- תמחור ---------- */
function stageFor_(d) {
  return d < STAGE2 ? 0 : d < STAGE3 ? 1 : 2;
}
function priceFor_(data, stage) {
  var att = String(data.attendance || '');
  var kind = att.indexOf('סופ"ש מלא') === 0 ? 'full' : (att ? 'one' : null);
  var lod = String(data.lodging || '').indexOf('במתחם') >= 0 ? 'y' : (data.lodging ? 'n' : null);
  if (!kind || !lod) return null;
  var t = PRICES[lod][kind][stage] + FOOD[kind];
  if (String(data.wine || '') === 'כן') t += WINE;
  return t;
}

/* ---------- עזרי גיליון ---------- */
function ensureSheet_(ss, name, headers) {
  var sh = ss.getSheetByName(name) || ss.insertSheet(name);
  if (sh.getLastRow() === 0) {
    sh.appendRow(headers);
    sh.setFrozenRows(1);
  } else {
    var cur = getHeaders_(sh);
    var missing = headers.filter(function (h) { return cur.indexOf(h) < 0; });
    if (missing.length) {
      sh.getRange(1, cur.length + 1, 1, missing.length).setValues([missing]);
    }
  }
  var pc = getHeaders_(sh).indexOf('phone');
  if (pc >= 0) sh.getRange(1, pc + 1, sh.getMaxRows(), 1).setNumberFormat('@');
  return sh;
}
function getHeaders_(sh) {
  var lc = sh.getLastColumn();
  if (!lc) return [];
  return sh.getRange(1, 1, 1, lc).getValues()[0].map(function (h) { return String(h).trim(); });
}
function findRow_(sh, phone) {
  var last = sh.getLastRow();
  if (last < 2) return null;
  var headers = getHeaders_(sh);
  var pi = headers.indexOf('phone');
  var vals = sh.getRange(2, 1, last - 1, headers.length).getValues();
  for (var r = 0; r < vals.length; r++) {
    if (normPhone_(vals[r][pi]) === phone) {
      var obj = {};
      headers.forEach(function (h, i) { obj[h] = vals[r][i]; });
      return { row: r + 2, obj: obj };
    }
  }
  return null;
}
function writeFlags_(row, headers, cols, list) {
  var chosen = (Array.isArray(list) ? list : String(list || '').split(','))
    .map(function (s) { return String(s).trim(); });
  cols.forEach(function (c) { setCol_(row, headers, c[0], chosen.indexOf(c[1]) >= 0 ? 'כן' : ''); });
}
function readFlags_(obj, cols) {
  return cols.filter(function (c) { return String(obj[c[0]] || '').trim() === 'כן'; })
    .map(function (c) { return c[1]; }).join(', ');
}
function setCol_(row, headers, name, val) {
  var i = headers.lastIndexOf(name);
  if (i >= 0) row[i] = val;
}
function normPhone_(p) {
  var d = String(p == null ? '' : p).replace(/\D/g, '');
  if (d.indexOf('972') === 0) d = '0' + d.slice(3);
  if (d.length === 9 && d[0] !== '0') d = '0' + d;
  return d.length >= 9 && d.length <= 10 ? d : '';
}
function getFolder_() {
  var it = DriveApp.getFoldersByName(RECEIPTS_FOLDER);
  return it.hasNext() ? it.next() : DriveApp.createFolder(RECEIPTS_FOLDER);
}
function respond_(obj, callback) {
  var json = JSON.stringify(obj);
  if (callback) {
    return ContentService.createTextOutput(callback + '(' + json + ');')
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }
  return ContentService.createTextOutput(json).setMimeType(ContentService.MimeType.JSON);
}