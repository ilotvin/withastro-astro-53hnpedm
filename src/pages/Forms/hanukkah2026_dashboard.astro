---
// hanukkah2026_dashboard.astro · Version: V13
// דשבורד – ריטריט חנוכה 2026

// ===== גרסה – להעלות ב-1 בכל עדכון =====
const VERSION = 'V13';
// =========================================
const UPDATED = new Intl.DateTimeFormat('he-IL', {
  timeZone: 'Asia/Jerusalem', day: '2-digit', month: '2-digit', year: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false
}).format(new Date()).replace(',', '');
---
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#A35A32" />
  <title>דשבורד – ריטריט חנוכה 2026</title>
  <style is:global>
    :root {
      --bg: #8A4B2A; --surface: #6E3A1F; --ink: #FFFFFF; --muted: #F3D9BF; --line: #A9683F;
      --sage: #F6C453; --sage-ink: #2A1A00; --gold: #FFB38A; --danger: #FFD0C8; --track: #5A2F18;
      --font: Arial, "Helvetica Neue", Helvetica, sans-serif;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    .gate { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
    .gate input { font: inherit; color: var(--ink); background: #9A5733; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 12em; }
    body { margin: 0; min-height: 100vh; background: linear-gradient(180deg, #A35A32 0, #8A4B2A 520px, #6E3A1F 100%) fixed; background-color: var(--bg); color: var(--ink); font-family: var(--font); font-size: 16px; line-height: 1.5; }
    .wrap { max-width: 900px; margin: 0 auto; padding: 32px 16px 56px; position: relative; }
    .version { position: absolute; top: 10px; left: 16px; font-size: 11px; color: var(--muted); opacity: .55; }
    header { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
    h1 { margin: 0; font-size: 28px; }
    .sub { margin: 4px 0 0; color: var(--muted); font-size: 14px; }
    .btn { font: inherit; font-weight: 700; padding: 10px 18px; border-radius: 999px; border: 0; background: var(--sage); color: var(--sage-ink); cursor: pointer; }
    .btn-ghost { background: transparent; color: var(--ink); border: 2px solid var(--sage); text-decoration: none; display: inline-flex; align-items: center; }
    .btn-small { padding: 7px 14px; font-size: 14px; }
    .btn:disabled { opacity: .6; cursor: progress; }
    .msg { color: var(--danger); margin: 0 0 16px; }
    .msg:empty { display: none; }

    .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
    .kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }
    .kpi span { display: block; font-size: 13px; color: var(--muted); }
    .kpi b { display: block; font-size: 32px; line-height: 1.1; margin-top: 4px; color: var(--sage); font-variant-numeric: tabular-nums; }
    .kpi small { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }

    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
    .card.wide { grid-column: 1 / -1; }
    .card.cap-compact { padding: 10px 14px; margin-bottom: 12px; }
    .card h2 { margin: 0 0 12px; font-size: 17px; }
    .cap-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 14px; }
    .cap-row label { font-size: 14px; font-weight: 700; }
    .cap-row input { font: inherit; color: var(--ink); background: #9A5733; border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; width: 4.5em; font-size: 14px; }
    .bar { display: grid; grid-template-columns: minmax(0, 9em) minmax(0, 1fr) 3em; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 14px; }
    .bar .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .bar .track { height: 12px; background: var(--track); border-radius: 999px; overflow: hidden; }
    .bar .fill { height: 100%; background: var(--sage); border-radius: 999px; }
    .bar .num { text-align: left; font-weight: 700; font-variant-numeric: tabular-nums; }
    .bar.zero .lbl, .bar.zero .num { color: var(--muted); font-weight: 400; }
    .night { margin-bottom: 14px; }
    .night:last-child { margin-bottom: 0; }
    .night .top { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 4px; }
    .night .track { height: 14px; background: var(--track); border-radius: 999px; overflow: hidden; display: flex; }
    .night .v { background: var(--sage); }
    .night .s { background: var(--gold); }
    .night.over .top b { color: var(--danger); }
    .legend { display: flex; gap: 14px; font-size: 13px; color: var(--muted); margin-top: 10px; }
    .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-left: 5px; vertical-align: middle; }
    .note { font-size: 13px; color: var(--muted); margin: 10px 0 0; }

    .picker-toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
    .picker-toolbar input[type="search"], .picker-toolbar select { font: inherit; color: var(--ink); background: #9A5733; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; }
    .picker-toolbar input[type="search"] { flex: 1 1 13em; }
    .picker-toolbar select { min-width: 14em; }
    .picker-toolbar input::placeholder { color: var(--muted); }
    .names-box { max-height: 220px; overflow-y: auto; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); padding: 10px 12px; display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 6px 12px; }
    .name-item { display: flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; padding: 4px 6px; border-radius: 8px; }
    .name-item:hover { background: var(--surface); }
    .name-item input { accent-color: var(--sage); width: 16px; height: 16px; margin: 0; cursor: pointer; }
    .selected-preview { margin-top: 10px; font-size: 14px; color: var(--muted); min-height: 1.4em; }
    .selected-preview b { color: var(--sage); }
    .selected-preview.warn { color: var(--danger); }

    .participant-details { margin-top: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); padding: 14px; }
    .participant-details-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
    .participant-details-head h3 { margin: 0; font-size: 16px; color: var(--sage); }
    .fields-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; font-size: 14px; }
    .field-row { padding: 6px 8px; border-radius: 8px; background: var(--surface); border: 1px solid var(--line); word-break: break-word; }
    .field-key { display: block; font-size: 12px; color: var(--muted); margin-bottom: 2px; }
    .field-val { color: var(--ink); font-weight: 700; white-space: pre-wrap; }

    @media (max-width: 700px) {
      .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid { grid-template-columns: 1fr; }
      .fields-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="version" dir="ltr">{VERSION} · {UPDATED}</div>
    <header>
      <div>
        <h1>דשבורד הרשמות</h1>
        <p class="sub">ריטריט חנוכה · מצפה רמון · 10–12 לדצמבר 26 · <span id="stamp">טוען…</span></p>
      </div>
      <div style="display:flex;gap:8px">
        <a class="btn btn-ghost" href="/Forms/hanukkah2026">לטופס</a>
        <button class="btn" id="refresh" type="button">רענון</button>
      </div>
    </header>
    <p class="msg" id="msg" role="status"></p>
    <div class="gate" id="gate" hidden>
      <input id="gatePhone" type="tel" inputmode="numeric" placeholder="מספר טלפון" />
      <button class="btn" id="gateBtn" type="button">כניסה</button>
    </div>

    <section class="card wide cap-compact" aria-label="שורות להפעלת פופאפ :הרשמה התמלאה">
      <div class="cap-row">
        <label for="capInput">שורות להפעלת פופאפ :הרשמה התמלאה</label>
        <input id="capInput" type="number" min="0" max="500" value="25" />
        <button class="btn btn-small" id="saveCapBtn" type="button">שמירה</button>
        <span id="capStatus" class="note" style="margin:0"></span>
      </div>
    </section>


    <section class="kpis" aria-label="מספרים עיקריים">
      <div class="kpi"><span>נרשמים</span><b id="k_total">–</b></div>
      <div class="kpi"><span>גברים</span><b id="k_male">–</b><small id="k_male_age"></small></div>
      <div class="kpi"><span>נשים</span><b id="k_female">–</b><small id="k_female_age"></small></div>
      <div class="kpi"><span>גיל ממוצע</span><b id="k_age">–</b><small id="k_unknown"></small></div>
    </section>

    <section class="grid">
      <div class="card"><h2>מתי מגיעים</h2><div id="c_att"></div></div>
      <div class="card">
        <h2>תפוסה לפי לילה (מכסה: 25)</h2>
        <div id="c_nights"></div>
        <div class="legend"><span><i style="background:var(--sage)"></i>לינה במתחם</span><span><i style="background:var(--gold)"></i>לינה עצמאית</span></div>
        <p class="note">המתחם גובה על כל משתתף מעל 25 בלילה, גם על מי שלא ישן בו.</p>
      </div>
      <div class="card wide"><h2>פעילויות מבוקשות</h2><div id="c_act"></div></div>
      <div class="card"><h2>הלפרים לפי תפקיד</h2><div id="c_roles"></div></div>
      <div class="card"><h2>עוד נתונים</h2><div id="c_more"></div></div>
      <div class="card wide"><h2>אישורים ותשלומים</h2><div id="c_pay"></div><p class="note">✅ מאושר · ✉️ מייל אישור נשלח · 💰 דיווח על תשלום · 📭 אין מייל</p></div>
    </section>
    <section class="card wide" id="participantsPickerCard" style="margin-top:12px" aria-label="בחירת שמות משתתפים והצגת פרטים">
      <h2>משתתפים – בחירה והצגת כל השדות</h2>
      <div class="picker-toolbar">
        <select id="participantSelect" aria-label="בחירת משתתף לצפייה בכל השדות">
          <option value="">בחר משתתף לצפייה בכל השדות…</option>
        </select>
        <select id="genderFilter" aria-label="סינון לפי מגדר">
          <option value="">כל המגדרים</option>
          <option value="גבר">גברים</option>
          <option value="אישה">נשים</option>
          <option value="__none">לא צוין</option>
        </select>
      </div>

      <div id="participantDetails" class="participant-details" hidden>
        <div class="participant-details-head">
          <h3 id="detailsTitle">פרטי משתתף</h3>
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <button class="btn btn-small" id="approveBtn" type="button">✅ אישור ושליחת מייל</button>
            <button class="btn btn-ghost btn-small" id="closeDetailsBtn" type="button">סגור תצוגת שדות</button>
          </div>
        </div>
        <p id="approveMsg" class="note" style="margin:0 0 10px" role="status"></p>
        <div id="detailsGrid" class="fields-grid"></div>
      </div>
    </section>
  </div>

  <script is:inline>
    // ===== הגדרות =====
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxSk0jbyPUpu-osqMjW2FWCFBR_sK2IQH1Tl36UsnKR1_65zwxwtuiP0hE7v0mmTGGw/exec';
    const CAP = 25;
    const LS_KEY = 'hanukkah2026_phone';
    let phone = '';
    try { phone = localStorage.getItem(LS_KEY) || ''; } catch {}
    // ==================

    const FIELD_LABELS = {
      name: 'שם מלא',
      full_name: 'שם מלא',
      phone: 'טלפון',
      email: 'מייל',
      attendance: 'מתי מגיעים',
      extra_night: 'לילה נוסף (שבת–ראשון)',
      lodging: 'לינה',
      age: 'גיל',
      gender: 'מגדר',
      why: 'למה להצטרף',
      prev_retreats: 'היה בריטריטים בעבר',
      prev_feedback: 'פידבק מריטריטים קודמים',
      social: 'רשת חברתית',
      car: 'הגעה / טרמפ',
      area: 'אזור יציאה',
      wine: 'מסלול יין',
      baking: 'אפייה',
      two_facts: 'שתי עובדות מעניינות',
      activities: 'פעילויות',
      connect_ideas: 'רעיונות לפעילויות מחברות',
      workshop: 'להעביר סדנה',
      story: 'לשתף סיפור',
      content_details: 'פרטי סדנה / סיפור',
      diet: 'תזונה',
      gluten: 'נמנע מגלוטן',
      allergies: 'אלרגיות',
      kashrut: 'מגבלות כשרות',
      milk: 'העדפת חלב',
      helper_roles: 'תפקידי הלפרים',
      payment: 'אמצעי תשלום',
      status: 'סטטוס',
      created: 'תאריך יצירה / הרשמה',
      updated: 'תאריך עדכון',
      total: 'סה"כ עלות',
      email_sent: 'מייל אישור נשלח',
      paid_type: 'סוג תשלום שדווח',
      paid_amount: 'סכום ששולם',
      paid_method: 'אמצעי תשלום בפועל',
      paid_at: 'מועד דיווח תשלום'
    };
    const APPROVED = 'מאושר';
    const isApproved = (p) => String(p?.raw?.status || '').trim() === APPROVED;
    const hasEmail = (p) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(p?.raw?.email || '').trim());
    const mailSent = (p) => !!String(p?.raw?.email_sent || '').trim();
    const paidType = (p) => String(p?.raw?.paid_type || '').trim();
    const mark = (p) => (isApproved(p) ? '✅ ' : '') + (mailSent(p) ? '✉️ ' : '') + p.name
      + (paidType(p) ? ` 💰 ${paidType(p)}${p.raw.paid_amount ? ' ' + p.raw.paid_amount + ' ₪' : ''}` : '')
      + (hasEmail(p) ? '' : ' 📭 אין מייל');

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    let latestTotal = 0;
    let participants = [];
    let activeDetailKey = '';

    function normPhone(v) {
      let d = String(v || '').replace(/\D/g, '');
      if (d.startsWith('972')) d = '0' + d.slice(3);
      return d;
    }

    function jsonp(params) {
      return new Promise((resolve, reject) => {
        const cb = 'cb_' + Date.now() + '_' + Math.floor(Math.random() * 1e6);
        const s = document.createElement('script');
        const timer = setTimeout(() => { cleanup(); reject(new Error('timeout')); }, 20000);
        function cleanup() { clearTimeout(timer); delete window[cb]; s.remove(); }
        window[cb] = (data) => { cleanup(); resolve(data); };
        s.onerror = () => { cleanup(); reject(new Error('network')); };
        s.src = SCRIPT_URL + '?' + new URLSearchParams({ ...params, callback: cb, t: Date.now() });
        document.head.appendChild(s);
      });
    }

    function bars(el, items) {
      const max = Math.max(1, ...items.map((i) => i.count));
      $(el).innerHTML = items.map((i) =>
        `<div class="bar${i.count ? '' : ' zero'}"><span class="lbl" title="${esc(i.label)}">${esc(i.label)}</span>` +
        `<div class="track"><div class="fill" style="width:${(i.count / max) * 100}%"></div></div>` +
        `<span class="num">${i.count}</span></div>`).join('');
    }
    const fromTally = (t, rename = {}) => Object.keys(t)
      .filter((k) => k !== 'לא צוין' || t[k] > 0)
      .map((k) => ({ label: rename[k] || k, count: t[k] }));

    function nights(n) {
      const row = (name, x) => {
        const tot = x.venue + x.self, scale = Math.max(CAP, tot);
        return `<div class="night${tot > CAP ? ' over' : ''}"><div class="top"><span>${name}</span><b>${tot} / ${CAP}</b></div>` +
          `<div class="track"><div class="v" style="width:${(x.venue / scale) * 100}%"></div><div class="s" style="width:${(x.self / scale) * 100}%"></div></div></div>`;
      };
      $('c_nights').innerHTML = row('חמישי בלילה', n.thu) + row('שישי בלילה', n.fri);
    }

    function updateCapSummary(capValue) {
      const cap = Number.isFinite(capValue) && capValue >= 0 ? capValue : CAP;
      $('capInput').value = cap;
      const active = cap > 0 && latestTotal >= cap;
      $('capStatus').textContent = `נרשמים נוכחים: ${latestTotal} מתוך ${cap} · פופ-אפ: ${active ? 'פעיל' : 'כבוי'}`;
    }

    function pickListFromObject(obj) {
      if (!obj || typeof obj !== 'object') return [];
      const keys = ['participants', 'registrants', 'rows', 'records', 'items', 'users', 'members', 'names', 'list', 'data'];
      for (const k of keys) {
        if (Array.isArray(obj[k]) && obj[k].length) return obj[k];
      }
      return [];
    }

    function extractParticipants(d) {
      const raw = pickListFromObject(d);
      if (!raw.length) return [];
      const list = [];
      raw.forEach((item, idx) => {
        if (typeof item === 'string') {
          const name = item.trim();
          if (name) list.push({ key: `${idx}__${name}`, name, raw: { name } });
          return;
        }
        if (item && typeof item === 'object') {
          const record = item.data && typeof item.data === 'object' ? { ...item, ...item.data } : { ...item };
          delete record.data;
          const name = String(record.name || record.full_name || record.שם || record.title || record.phone || `משתתף ${idx + 1}`).trim();
          const key = String(record.phone || record.id || `${idx}__${name}`);
          list.push({ key, name, raw: record });
        }
      });
      return list;
    }

    function matchesSearch(p, q) {
      if (!q) return true;
      const g = String(p.raw?.gender || '').trim();
      return q === '__none' ? !g : g === q;
    }

    function formatFieldValue(val) {
      if (val === null || val === undefined || val === '') return '–';
      if (Array.isArray(val)) return val.length ? val.join(', ') : '–';
      if (typeof val === 'object') return JSON.stringify(val, null, 2);
      return String(val);
    }

    function renderParticipantDetails(key) {
      activeDetailKey = key || '';
      const sel = $('participantSelect');
      if (sel && sel.value !== activeDetailKey) sel.value = activeDetailKey;

      const p = participants.find((item) => item.key === activeDetailKey);
      if (!p) {
        $('participantDetails').hidden = true;
        $('detailsGrid').innerHTML = '';
        return;
      }

      $('detailsTitle').textContent = `כל השדות של: ${p.name}`;
      const entries = Object.entries(p.raw || {});
      $('detailsGrid').innerHTML = entries.length
        ? entries.map(([k, v]) => {
            const label = FIELD_LABELS[k] || k;
            return `<div class="field-row"><span class="field-key">${esc(label)} (${esc(k)})</span><span class="field-val">${esc(formatFieldValue(v))}</span></div>`;
          }).join('')
        : `<div class="field-row"><span class="field-key">שם</span><span class="field-val">${esc(p.name)}</span></div>`;

      $('participantDetails').hidden = false;
      syncApproveBtn(p);
    }

    function syncApproveBtn(p) {
      const btn = $('approveBtn');
      const sent = String(p.raw?.email_sent || '').trim();
      const noMail = hasEmail(p) ? '' : '📭 אין כתובת מייל – מייל אישור לא יישלח.';
      const paidMsg = paidType(p) ? `💰 דיווח: ${paidType(p)} ${p.raw.paid_amount || ''} ₪ ב${p.raw.paid_method || ''} (${p.raw.paid_at || ''})` : '';
      $('approveMsg').textContent = [isApproved(p)
        ? ('✅ מאושר' + (sent ? ' · ✉️ מייל נשלח ' + sent : ' · מייל לא נשלח'))
        : '', paidMsg, noMail].filter(Boolean).join(' · ');
      btn.textContent = !hasEmail(p) ? (isApproved(p) ? '✅ מאושר (אין מייל)' : '✅ אישור (ללא מייל)')
        : !isApproved(p) ? '✅ אישור ושליחת מייל' : (sent ? '✉️ שליחת מייל חוזרת' : '✉️ שליחת מייל');
      btn.disabled = false;
    }

    function renderSelectOptions() {
      const sel = $('participantSelect');
      if (!sel) return;
      const current = activeDetailKey;
      sel.innerHTML = '<option value="">בחר משתתף לצפייה בכל השדות…</option>' +
        participants.filter((p) => matchesSearch(p, $('genderFilter')?.value || ''))
          .map((p) => `<option value="${esc(p.key)}"${p.key === current ? ' selected' : ''}>${esc(mark(p))}</option>`).join('');
    }

    function renderNamesList() {
      renderSelectOptions();
    }

    async function tryFetchParticipantsList(currentPhone) {
      const candidateActions = ['list', 'registrants', 'participants', 'get_all'];
      for (const act of candidateActions) {
        try {
          const res = await jsonp({ action: act, phone: currentPhone });
          if (res && res.ok) {
            const found = extractParticipants(res);
            if (found.length) return found;
          }
        } catch {}
      }
      return [];
    }

    function render(d) {
      const g = d.gender || {}, a = d.age || {};
      latestTotal = Number(d.total) || 0;
      $('k_total').textContent = latestTotal;
      $('k_male').textContent = g['גבר'] || 0;
      $('k_female').textContent = g['אישה'] || 0;
      $('k_age').textContent = a.all ?? '–';
      $('k_male_age').textContent = a.male != null ? 'גיל ממוצע ' + a.male : '';
      $('k_female_age').textContent = a.female != null ? 'גיל ממוצע ' + a.female : '';
      $('k_unknown').textContent = g['לא צוין'] ? g['לא צוין'] + ' בלי מגדר' : '';

      bars('c_att', fromTally(d.attendance || {}, { 'סופ"ש מלא (חמישי–שבת)': 'סופ"ש מלא' }));
      nights(d.nights || { thu: { venue: 0, self: 0 }, fri: { venue: 0, self: 0 } });
      bars('c_act', d.activities || []);
      bars('c_roles', d.roles || []);
      bars('c_more', [
        { label: 'לינה במתחם', count: d.lodging?.['לינה במתחם (מזרנים על פרקט)'] || 0 },
        { label: 'לינה עצמאית', count: d.lodging?.['לינה עצמאית (מלון / B&B)'] || 0 },
        { label: 'מסלול יין', count: d.wine || 0 },
        { label: 'לילה נוסף: כן', count: d.extraNight?.['כן'] || 0 },
        { label: 'לילה נוסף: אולי', count: d.extraNight?.['אולי'] || 0 }
      ]);
      const ap = d.approvals || {};
      bars('c_pay', [
        { label: '✅ מאושרים', count: ap.approved || 0 },
        { label: '✉️ מייל אישור נשלח', count: ap.emailSent || 0 },
        { label: '💰 שילמו מקדמה', count: ap.paidDeposit || 0 },
        { label: '💰 שילמו מלא', count: ap.paidFull || 0 }
      ]);

      const validKeys = new Set(participants.map((p) => p.key));

      renderSelectOptions();
      renderNamesList();
      if (activeDetailKey && validKeys.has(activeDetailKey)) {
        renderParticipantDetails(activeDetailKey);
      } else {
        renderParticipantDetails('');
      }

      if (d.capacity !== undefined) {
        updateCapSummary(parseInt(d.capacity, 10));
      }

      $('stamp').textContent = 'עודכן ' + new Date(d.updated || Date.now()).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
    }

    async function load() {
      if (!phone) { $('gate').hidden = false; $('stamp').textContent = ''; return; }
      $('refresh').disabled = true;
      $('msg').textContent = '';
      try {
        const d = await jsonp({ action: 'stats', phone });
        if (!d.ok) throw new Error(d.error === 'unauthorized' ? 'אין הרשאה לצפות בנתונים.' : d.error);
        $('gate').hidden = true;
        let list = extractParticipants(d);
        if (!list.length) {
          list = await tryFetchParticipantsList(phone);
        }
        participants = list;
        render(d);
      } catch (e) {
        $('stamp').textContent = '';
        $('gate').hidden = false;
        $('msg').textContent = e.message === 'timeout' || e.message === 'network' ? 'הטעינה נכשלה. נסו לרענן.' : e.message;
      } finally {
        $('refresh').disabled = false;
      }
    }

    $('participantSelect')?.addEventListener('change', async (e) => {
      const key = e.target.value;
      renderParticipantDetails(key);
      const p = participants.find((item) => item.key === key);
      const targetPhone = normPhone(p?.raw?.phone || '');
      if (p && targetPhone && Object.keys(p.raw || {}).length <= 2) {
        try {
          const single = await jsonp({ action: 'get', phone: targetPhone });
          if (single && single.ok && single.found && single.data) {
            p.raw = { ...p.raw, ...single.data };
            renderParticipantDetails(key);
          }
        } catch {}
      }
    });

    $('approveBtn')?.addEventListener('click', async () => {
      const p = participants.find((item) => item.key === activeDetailKey);
      const target = normPhone(p?.raw?.phone || '');
      if (!p || !target) return;
      const sent = String(p.raw?.email_sent || '').trim();
      const resend = isApproved(p) && !!sent;
      const email = String(p.raw?.email || '').trim();
      const q = resend ? `לשלוח שוב מייל אישור ל-${p.name}?` : `לאשר את ${p.name}${email ? ' ולשלוח מייל ל-' + email : ' (אין מייל – רק סימון כמאושר)'}?`;
      if (!confirm(q)) return;
      const btn = $('approveBtn');
      btn.disabled = true;
      $('approveMsg').textContent = 'שולח…';
      try {
        const r = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify({ action: 'approve', phone, target, resend }) });
        const res = await r.json();
        if (!res.ok) throw new Error(res.error === 'unauthorized' ? 'אין הרשאה.' : res.error);
        p.raw.status = res.status;
        if (res.email_sent) p.raw.email_sent = res.email_sent;
        renderSelectOptions();
        renderNamesList();
        renderParticipantDetails(p.key);
        if (!res.emailSent) {
          $('approveMsg').textContent = res.reason === 'no email' ? 'סומן כמאושר. אין כתובת מייל – המייל לא נשלח.'
            : res.reason === 'already sent' ? 'מאושר. מייל כבר נשלח ב-' + res.email_sent : 'סומן כמאושר.';
        }
      } catch (e) {
        $('approveMsg').textContent = 'שגיאה: ' + (e.message || e);
        btn.disabled = false;
      }
    });

    $('closeDetailsBtn')?.addEventListener('click', () => {
      renderParticipantDetails('');
    });

    $('genderFilter')?.addEventListener('change', renderNamesList);

    $('saveCapBtn').addEventListener('click', async () => {
      if (!phone) {
        $('capStatus').textContent = 'יש להתחבר תחילה עם מספר טלפון.';
        return;
      }
      const cap = parseInt($('capInput').value, 10);
      if (!Number.isFinite(cap) || cap < 0) {
        $('capStatus').textContent = 'יש להזין מספר תקין (0 ומעלה).';
        return;
      }
      $('saveCapBtn').disabled = true;
      $('capStatus').textContent = 'שומר…';
      try {
        const r = await fetch(SCRIPT_URL, {
          method: 'POST',
          body: JSON.stringify({ action: 'set_capacity', phone, capacity: cap })
        });
        const res = await r.json();
        if (!res.ok) throw new Error(res.error);
        updateCapSummary(parseInt(res.capacity, 10));
      } catch (e) {
        $('capStatus').textContent = 'שגיאה בשמירה: ' + (e.message || e);
      } finally {
        $('saveCapBtn').disabled = false;
      }
    });

    $('gateBtn').addEventListener('click', () => {
      phone = normPhone($('gatePhone').value);
      try { if (phone) localStorage.setItem(LS_KEY, phone); } catch {}
      load();
    });
    $('gatePhone')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        $('gateBtn').click();
      }
    });
    $('refresh').addEventListener('click', load);
    load();
  </script>
</body>
</html>