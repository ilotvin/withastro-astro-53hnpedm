---
// File: meetup_27_11_26_dashboard.astro
// דשבורד – ערב משחקים, חיבורים ומוסיקה (27.11.26)

const VERSION = 'V3';
const UPDATED = new Intl.DateTimeFormat('he-IL', {
  timeZone: 'Asia/Jerusalem', day: '2-digit', month: '2-digit', year: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false
}).format(new Date()).replace(',', '');
---
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<meta name="theme-color" content="#0A7090" />
<title>דשבורד – ערב חיבורים (27.11.26)</title>
<style is:global>
:root {
  --bg: #0A7090; --surface: #0D5F7A; --ink: #FFFFFF; --muted: #C6EEF5; --line: #2A8BA8;
  --sage: #FFD23F; --sage-ink: #2A2100; --gold: #FF7AB6; --danger: #FFB4B4; --track: #08485E;
  --font: Arial, "Helvetica Neue", Helvetica, sans-serif;
  color-scheme: dark;
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 16px; line-height: 1.5; }
.wrap { max-width: 900px; margin: 0 auto; padding: 32px 16px 56px; position: relative; }
.version { position: absolute; top: 10px; left: 16px; font-size: 11px; color: var(--muted); opacity: .55; }
header { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
h1 { margin: 0; font-size: 28px; }
.sub { margin: 4px 0 0; color: var(--muted); font-size: 14px; }
.btn { font: inherit; font-weight: 700; padding: 9px 16px; border-radius: 999px; border: 0; background: var(--sage); color: var(--sage-ink); cursor: pointer; }
.btn-ghost { background: transparent; color: var(--ink); border: 2px solid var(--sage); text-decoration: none; }
.btn-small { padding: 6px 12px; font-size: 13px; }
.btn:disabled { opacity: .6; cursor: progress; }
.msg { color: var(--danger); margin: 0 0 14px; }
.msg:empty { display: none; }
.gate { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 16px; }
.gate input, .cap-box input, .search-input { font: inherit; color: var(--ink); background: #13809F; border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; }
.gate input { min-width: 12em; }
.cap-box { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 12px 16px; margin-bottom: 16px; }
.cap-box label { font-weight: 700; font-size: 15px; }
.cap-box input { width: 6em; text-align: center; }
.cap-status { font-size: 14px; color: var(--muted); }
.kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
.kpi { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px; }
.kpi span { display: block; font-size: 13px; color: var(--muted); }
.kpi b { display: block; font-size: 32px; line-height: 1.1; margin-top: 4px; color: var(--sage); font-variant-numeric: tabular-nums; }
.kpi small { display: block; font-size: 13px; color: var(--muted); margin-top: 2px; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 16px; }
.card.wide { grid-column: 1 / -1; }
.card h2 { margin: 0 0 12px; font-size: 17px; }
.bar { display: grid; grid-template-columns: minmax(0, 9em) minmax(0, 1fr) 3em; align-items: center; gap: 10px; margin-bottom: 8px; font-size: 14px; }
.bar .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar .track { height: 12px; background: var(--track); border-radius: 999px; overflow: hidden; }
.bar .fill { height: 100%; background: var(--sage); border-radius: 999px; }
.bar .num { text-align: left; font-weight: 700; font-variant-numeric: tabular-nums; }
.bar.zero .lbl, .bar.zero .num { color: var(--muted); font-weight: 400; }
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.chip { font: inherit; font-size: 14px; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--track); color: var(--ink); cursor: pointer; }
.chip.active { background: var(--sage); color: var(--sage-ink); border-color: var(--sage); font-weight: 700; }
.details-box { margin-top: 14px; padding: 14px; border-radius: 12px; background: var(--track); border: 1px solid var(--line); }
.details-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 16px; font-size: 14px; }
.details-grid div b { color: var(--sage); }
@media (max-width: 700px) {
  .kpis { grid-template-columns: 1fr; }
  .grid, .details-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="wrap">
<div class="version" dir="ltr">{VERSION} · {UPDATED}</div>
<header>
  <div>
    <h1>דשבורד – 27.11.26</h1>
    <p class="sub">ערב משחקים, חיבורים ומוסיקה · <span id="stamp">טוען…</span></p>
  </div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a class="btn btn-ghost" href="/Forms/meetup_27_11_26">לטופס</a>
    <button class="btn" id="refresh" type="button">רענון</button>
  </div>
</header>

<p class="msg" id="msg" role="status"></p>

<div class="gate" id="gate" hidden>
  <input id="gatePhone" type="tel" inputmode="numeric" placeholder="מספר טלפון (0546655862)" />
  <button class="btn" id="gateBtn" type="button">כניסה</button>
</div>

<section class="cap-box" aria-label="הגדרת פופ-אפ הקבוצה מלאה">
  <label for="capInput">שורות להפעלת פופ-אפ "הקבוצה התמלאה":</label>
  <input id="capInput" type="number" min="0" max="500" value="5" />
  <button class="btn" id="saveCapBtn" type="button">שמירה</button>
  <span class="cap-status" id="capStatus"></span>
</section>

<section class="kpis" aria-label="מספרים עיקריים">
  <div class="kpi"><span>נרשמים (סה"כ שורות)</span><b id="k_total">–</b></div>
  <div class="kpi"><span>גברים / נשים</span><b id="k_gender">–</b><small id="k_gender_sub"></small></div>
  <div class="kpi"><span>גיל ממוצע</span><b id="k_age">–</b><small id="k_age_sub"></small></div>
</section>

<section class="grid">
  <div class="card"><h2>מסלולי שתייה</h2><div id="c_drink"></div></div>
  <div class="card"><h2>אמצעי תשלום</h2><div id="c_pay"></div></div>

  <div class="card wide">
    <h2>נרשמים (לחיצה מציגה את כל הפרטים)</h2>
    <input id="searchBox" class="search-input" type="search" placeholder="חיפוש לפי שם או טלפון…" style="width:100%;max-width:22em" />
    <div id="peopleChips" class="chips"></div>
    <div id="personDetails" class="details-box" hidden></div>
  </div>
</section>
</div>

<script is:inline>
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwAcpkaCneX6EVNnFlr0LAzcfsQWJrLRi-6PiXGsDAgQOUzPyp5_qioB8LTtOLhaCay/exec';
const LS_KEY = 'meetup_27_11_26_phone';
let phone = '';
let latestTotal = 0;
let allPeople = [];
let selectedIdx = -1;

const FIELD_LABELS = [
  ['name', 'שם מלא'], ['phone', 'טלפון'], ['age', 'גיל'], ['gender', 'מגדר'], ['city', 'עיר'],
  ['name_en', 'סושיאל'], ['occupation', 'עיסוק'], ['hobby', 'תחביב'], ['surprising_fact', 'עובדה מפתיעה'],
  ['why_join', 'למה להצטרף'], ['no_plus', 'מחפש פרטנר'], ['guest_name', 'שם +1'], ['guest_age', 'גיל +1'],
  ['guest_phone', 'טלפון +1'], ['guest_how_know', 'היכרות עם +1'], ['guest_why', 'למה ה-+1 ייהנה'],
  ['drink_track', 'מסלול שתייה'], ['guest_track', 'מסלול שתייה +1'], ['payment', 'תשלום'],
  ['share_story', 'לשתף סיפור'], ['story_details', 'פירוט סיפור'], ['game_activity', 'משחק/פעילות'],
  ['open_question', 'הערה פתוחה'], ['waitlist_popup', 'הופיע פופ-אפ מלא']
];

function normPhone(v) {
  let d = String(v || '').replace(/\D/g, '');
  if (d.startsWith('972')) d = '0' + d.slice(3);
  if (/^[1-9]\d{7,8}$/.test(d)) d = '0' + d;
  return d;
}

try { phone = normPhone(localStorage.getItem(LS_KEY) || ''); } catch {}

const $ = (id) => document.getElementById(id);
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

function jsonp(params) {
  return new Promise((resolve, reject) => {
    const cb = 'cb_' + Date.now() + '_' + Math.floor(Math.random() * 1e6);
    const s = document.createElement('script');
    const timer = setTimeout(() => { cleanup(); reject(new Error('timeout')); }, 15000);
    function cleanup() { clearTimeout(timer); delete window[cb]; s.remove(); }
    window[cb] = (data) => { cleanup(); resolve(data); };
    s.onerror = () => { cleanup(); reject(new Error('network')); };
    s.src = SCRIPT_URL + '?' + new URLSearchParams({ ...params, callback: cb, t: Date.now() });
    document.head.appendChild(s);
  });
}

function bars(el, tallyObj) {
  const items = Object.keys(tallyObj).map((k) => ({ label: k, count: tallyObj[k] }));
  const max = Math.max(1, ...items.map((i) => i.count));
  $(el).innerHTML = items.map((i) =>
    `<div class="bar${i.count === 0 ? ' zero' : ''}">` +
    `<span class="lbl">${esc(i.label)}</span>` +
    `<div class="track"><div class="fill" style="width:${(i.count / max) * 100}%"></div></div>` +
    `<span class="num">${i.count}</span></div>`
  ).join('');
}

function updateCapStatus(cap) {
  const n = Math.max(0, parseInt(cap, 10) || 0);
  const active = n > 0 && latestTotal >= n;
  $('capStatus').textContent = `שורות שנכנסו: ${latestTotal} מתוך ${n} · פופ-אפ: ${active ? 'פעיל' : 'כבוי'}`;
}

function renderPeopleList() {
  const q = String($('searchBox')?.value || '').trim().toLowerCase();
  const filtered = allPeople
    .map((p, idx) => ({ p, idx }))
    .filter(({ p }) => !q || String(p.name || '').toLowerCase().includes(q) || String(p.phone || '').includes(q));

  if (!filtered.length) {
    $('peopleChips').innerHTML = '<span style="color:var(--muted);font-size:14px">אין נרשמים להצגה.</span>';
    $('personDetails').hidden = true;
    return;
  }

  $('peopleChips').innerHTML = filtered.map(({ p, idx }) => {
    const label = `${p.name || 'ללא שם'}${p.guest_name ? ' + ' + p.guest_name : ''}`;
    return `<button type="button" class="chip${idx === selectedIdx ? ' active' : ''}" data-idx="${idx}">${esc(label)}</button>`;
  }).join('');

  $('peopleChips').querySelectorAll('.chip').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-idx'));
      selectedIdx = selectedIdx === idx ? -1 : idx;
      renderPeopleList();
      renderPersonDetails();
    });
  });
}

function renderPersonDetails() {
  const box = $('personDetails');
  if (selectedIdx < 0 || !allPeople[selectedIdx]) {
    box.hidden = true;
    return;
  }
  const p = allPeople[selectedIdx];
  const rows = FIELD_LABELS
    .filter(([k]) => String(p[k] ?? '').trim() !== '' && String(p[k] ?? '').toUpperCase() !== 'FALSE')
    .map(([k, lbl]) => {
      const val = String(p[k]).toUpperCase() === 'TRUE' ? 'כן' : String(p[k]);
      return `<div><b>${esc(lbl)}:</b> ${esc(val)}</div>`;
    });
  box.innerHTML = `<div class="details-grid">${rows.join('')}</div>`;
  box.hidden = false;
}

function render(d) {
  allPeople = Array.isArray(d.registrants) ? d.registrants : (Array.isArray(d.registrations) ? d.registrations : []);
  latestTotal = typeof d.total === 'number' ? d.total : allPeople.length;
  const g = d.gender || {};
  const a = d.age || {};
  $('k_total').textContent = latestTotal;
  $('k_gender').textContent = `${g['גבר'] || 0} / ${g['אישה'] || 0}`;
  $('k_gender_sub').textContent = g['לא צוין'] ? `${g['לא צוין']} ללא מגדר` : '';
  $('k_age').textContent = a.all ?? '–';
  $('k_age_sub').textContent = [a.male != null ? `גברים ${a.male}` : '', a.female != null ? `נשים ${a.female}` : ''].filter(Boolean).join(' · ');

  bars('c_drink', d.drink_track || {});
  bars('c_pay', d.payment || {});

  if (typeof d.capacity === 'number') {
    $('capInput').value = d.capacity;
  }
  updateCapStatus($('capInput').value);
  renderPeopleList();
  renderPersonDetails();
  $('stamp').textContent = 'עודכן ' + new Date(d.updated).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
}

async function load() {
  if (!phone) { $('gate').hidden = false; $('stamp').textContent = 'נדרש מספר טלפון'; return; }
  $('refresh').disabled = true;
  $('msg').textContent = '';
  try {
    const d = await jsonp({ action: 'stats', phone });
    if (!d || !d.ok) throw new Error(d?.error === 'unauthorized' ? 'אין הרשאה לצפות בנתונים.' : (d?.error || 'שגיאה בטעינה'));
    $('gate').hidden = true;
    render(d);
  } catch (e) {
    $('stamp').textContent = '';
    $('gate').hidden = false;
    $('msg').textContent = e.message === 'timeout' || e.message === 'network' ? 'הטעינה נכשלה. נסו לרענן.' : e.message;
  } finally {
    $('refresh').disabled = false;
  }
}

$('saveCapBtn').addEventListener('click', async () => {
  const cap = parseInt($('capInput').value, 10);
  if (!Number.isFinite(cap) || cap < 0) {
    $('capStatus').textContent = 'יש להזין מספר תקין (0 ומעלה).';
    return;
  }
  if (!phone) {
    $('capStatus').textContent = 'יש להזין מספר טלפון מורשה תחילה.';
    $('gate').hidden = false;
    return;
  }
  $('saveCapBtn').disabled = true;
  $('capStatus').textContent = 'שומר…';
  try {
    const r = await fetch(SCRIPT_URL, {
      method: 'POST',
      body: JSON.stringify({ action: 'set_capacity', phone, capacity: cap })
    });
    const res = await r.json();
    if (!res || !res.ok) throw new Error(res?.error || 'שגיאה בשמירה');
    $('capInput').value = res.capacity;
    updateCapStatus(res.capacity);
  } catch (err) {
    $('capStatus').textContent = 'שגיאה בשמירה: ' + (err.message || err);
  } finally {
    $('saveCapBtn').disabled = false;
  }
});

$('searchBox')?.addEventListener('input', renderPeopleList);
$('gateBtn').addEventListener('click', () => {
  phone = normPhone($('gatePhone').value);
  try { localStorage.setItem(LS_KEY, phone); } catch {}
  load();
});

$('refresh').addEventListener('click', load);
load();
</script>
</body>
</html>
// End of File: meetup_27_11_26_dashboard.astro