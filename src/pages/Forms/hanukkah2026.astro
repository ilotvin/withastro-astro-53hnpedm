// ===== גרסה – להעלות ב-1 בכל עדכון =====
const VERSION = 'V22';
// =========================================

// תאריך ושעת העדכון נקבעים אוטומטית ברגע ה-deploy (שעון ישראל)
const UPDATED = new Intl.DateTimeFormat('he-IL', {
  timeZone: 'Asia/Jerusalem', day: '2-digit', month: '2-digit', year: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false
}).format(new Date()).replace(',', '');
---
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#A35A32" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500&display=swap" rel="stylesheet" />
  <title>מנגנים שרים ביחד – ריטריט חנוכה במצפה רמון</title>
  <meta property="og:title" content="מנגנים שרים ביחד – ריטריט חנוכה במצפה רמון" />
  <meta property="og:description" content="10–12 לדצמבר 26 · שלושה ימים של ג'אמים, סדנאות ומדורה מול המכתש. נרשמים ומעדכנים מתי שרוצים." />
  <meta property="og:image" content="https://atroproject1.vercel.app/images/hanukkah2026.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="900" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://atroproject1.vercel.app/Forms/hanukkah2026" />
  <style is:global>
    :root {
      --bg: #8A4B2A; --surface: #6E3A1F; --ink: #FFFFFF; --muted: #F3D9BF; --line: #A9683F;
      --sage: #F6C453; --sage-ink: #2A1A00; --gold: #FFB38A; --gold-soft: #5E3018; --danger: #FFD0C8;
      --field: #9A5733;
      --font: Arial, "Helvetica Neue", Helvetica, sans-serif;
      color-scheme: dark;
    }
    html { scroll-behavior: smooth; }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; min-height: 100vh; background: linear-gradient(180deg, #A35A32 0, #8A4B2A 520px, #6E3A1F 100%) fixed; background-color: var(--bg); color: var(--ink); font-family: var(--font); font-size: 17px; line-height: 1.6; }
    .wrap { max-width: 640px; margin: 0 auto; padding: 0 20px 64px; position: relative; }
    .version { position: absolute; top: 10px; left: 20px; font-size: 11px; color: var(--muted); opacity: .55; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
    h1, h2 { font-family: var(--font); font-weight: 700; line-height: 1.1; margin: 0; }
    h1 { font-size: clamp(38px, 10vw, 60px); letter-spacing: -0.01em; }
    h2 { font-size: 30px; }
    .muted { color: var(--muted); }
    .req { color: var(--gold); font-weight: 700; }
    .hero { padding: 48px 0 32px; text-align: center; }
    .subtitle { font-weight: 700; font-size: clamp(21px, 5vw, 28px); line-height: 1.25; margin: 10px 0 0; color: var(--sage); }
    .event-date { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 14px 0 0; font-family: "Frank Ruhl Libre", serif; font-size: 18px; letter-spacing: .12em; color: var(--muted); }
    .event-date .sep { width: 28px; height: 1px; background: var(--sage); opacity: .8; }
    .event-place { margin: 6px 0 0; font-size: 16px; }
    .stage { display: inline-block; margin-top: 16px; padding: 6px 16px; border-radius: 999px; background: var(--sage); color: var(--sage-ink); font-weight: 700; font-size: 15px; }
    .waitlist-banner { margin: 0 0 18px; padding: 12px 16px; border-radius: 12px; background: var(--gold-soft); border: 1px solid var(--gold); color: var(--ink); font-size: 15px; }
    .waitlist-banner b { color: var(--sage); }
    .cover { width: 80%; margin: 20px auto 0; border-radius: 14px; overflow: hidden; background: var(--surface); }
    .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
    .cover.is-empty { aspect-ratio: 16 / 9; display: grid; place-items: center; border: 2px dashed var(--line); background: transparent; }
    .cover.is-empty::after { content: "כאן תופיע תמונה"; color: var(--muted); font-size: 16px; }
    .btn { display: inline-block; font: inherit; font-weight: 700; padding: 12px 22px; border-radius: 999px; border: 2px solid var(--sage); background: transparent; color: var(--ink); text-decoration: none; cursor: pointer; }
    .btn-primary { background: var(--sage); color: var(--sage-ink); }
    .btn-danger { border-color: var(--danger); color: var(--danger); }
    .btn-small { padding: 8px 16px; font-size: 15px; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .btn:disabled { opacity: .55; cursor: progress; }
    :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
    .join { padding-top: 24px; border-top: 1px solid var(--line); }
    .about-jump { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; padding: 14px 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); }
    .about-jump p { margin: 0; font-weight: 700; }
    .join > p { margin: 8px 0 20px; }
    .field { margin-bottom: 18px; }
    .field > label, .q { display: block; font-weight: 700; margin-bottom: 6px; }
    input[type=text], input[type=tel], input[type=number], input[type=email], textarea { width: 100%; font: inherit; color: var(--ink); background: var(--field); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
    input[dir=ltr] { text-align: left; }
    input[dir=ltr]:placeholder-shown { direction: rtl; text-align: right; }
    input[type=number] { max-width: 8em; }
    textarea { min-height: 80px; resize: vertical; }
    input::placeholder, textarea::placeholder { color: var(--muted); }
    .hint { font-size: 15px; color: var(--muted); margin: 6px 0 0; }
    fieldset { border: 0; padding: 0; margin: 0; }
    .group { padding: 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); margin-bottom: 18px; }
    .group > legend { font-size: 19px; font-weight: 700; margin: 0 0 10px; float: right; width: 100%; }
    .legend-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .group > legend + * { clear: both; }
    .group-intro { font-size: 16px; color: var(--muted); margin: 0 0 16px; }
    .modes { display: grid; gap: 8px; }
    .modes label { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; font-weight: 400; }
    .modes label:has(input:checked) { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
    .modes input { margin: 0; accent-color: var(--sage); flex: none; width: 18px; height: 18px; }
    .modes.inline { grid-template-columns: repeat(2, 1fr); max-width: 18em; }
    .modes.inline.three { grid-template-columns: repeat(3, 1fr); max-width: 26em; }
    .modes.inline label { justify-content: center; }
