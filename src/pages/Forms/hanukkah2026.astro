  <script is:inline>
    // ===== הגדרות – להדביק את כתובת ה-Web App אחרי פריסת ה-Apps Script =====
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxSk0jbyPUpu-osqMjW2FWCFBR_sK2IQH1Tl36UsnKR1_65zwxwtuiP0hE7v0mmTGGw/exec';
    const LS_KEY = 'hanukkah2026_phone';
    // =======================================================================

    // תמחור (חייב להתאים ל-Code_hanukkah2026.gs)
    const PRICES = { y: { full: [350, 400, 450], one: [290, 340, 390] }, n: { full: [200, 250, 300], one: [140, 190, 240] } };
    const FOOD = { full: 200, one: 100 };
    const WINE = 90;
    const STAGE2 = new Date(2026, 10, 27), STAGE3 = new Date(2026, 11, 3);
    const STAGE_LABEL = ['הרשמה מוקדמת עד 26.11, לאחר מכן המחיר עולה', 'שלב שני עד 2.12', 'שלב אחרון'];
    const stageFor = (d) => d < STAGE2 ? 0 : d < STAGE3 ? 1 : 2;

    const TEXT = ['name', 'email', 'age', 'why', 'prev_feedback', 'social', 'area', 'baking',
      'two_facts', 'connect_ideas', 'content_details', 'allergies', 'kashrut'];
    const RADIOS = ['attendance', 'extra_night', 'lodging', 'gender', 'prev_retreats', 'car',
      'workshop', 'story', 'diet', 'gluten', 'milk', 'payment'];
    const CHECKS = ['wine', 'activities', 'helper_roles'];

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const els = { form: $('form'), phone: $('phone'), loadMsg: $('loadMsg'), saveBtn: $('saveBtn'),
      saveMsg: $('saveMsg'), deleteBtn: $('deleteBtn'), refreshBtn: $('refreshBtn') };
    let loadedPhone = '';
    let createdAt = null;

    function jsonp(params) {
      return new Promise((resolve, reject) => {
        const cb = 'cb_' + Date.now() + '_' + Math.floor(Math.random() * 1e6);
        const s = document.createElement('script');
        const timer = setTimeout(() => { cleanup(); reject(new Error('timeout')); }, 15000);
        function cleanup() { clearTimeout(timer); delete window[cb]; s.remove(); }
        window[cb] = (data) => { cleanup(); resolve(data); };
        s.onerror = () => { cleanup(); reject(new Error('network')); };
        s.src = SCRIPT_URL + '?' + new URLSearchParams({ ...params, callback: cb, t: Date.now() });
        document.head.appendChild(s);
      });
    }

    async function post(payload, ms = 20000) {
      const ctrl = new AbortController();
      const timer = setTimeout(() => ctrl.abort(), ms);
      try {
        const r = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload), signal: ctrl.signal });
        return await r.json();
      } catch (e) {
        throw new Error(e.name === 'AbortError' ? 'timeout' : 'network');
      } finally {
        clearTimeout(timer);
      }
    }

    function normPhone(v) {
      let d = String(v || '').replace(/\D/g, '');
      if (d.startsWith('972')) d = '0' + d.slice(3);
      return d;
    }
    const validPhone = (d) => /^0\d{8,9}$/.test(d);
    const validAge = (v) => /^\d{1,2}$/.test(v) && +v >= 18 && +v <= 99;
    const validEmail = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    const radioVal = (n) => document.querySelector(`input[name="${n}"]:checked`)?.value || '';
    const checkVals = (n) => [...document.querySelectorAll(`input[name="${n}"]:checked`)].map((i) => i.value).join(', ');
    function setMsg(el, text, kind) { el.textContent = text; el.className = el === els.loadMsg ? 'hint' : 'msg ' + (kind || ''); }
    const errText = (err) => err.message === 'timeout' ? 'אין תגובה מהשרת. נסו שוב.'
      : err.message === 'network' ? 'בעיית חיבור. נסו שוב.' : err.message;
    const fmt = (n) => Number(n).toLocaleString('he-IL') + ' ₪';

    function choice() {
      const a = radioVal('attendance'), l = radioVal('lodging');
      if (!a || !l) return null;
      return { kind: a.startsWith('סופ"ש מלא') ? 'full' : 'one', lod: l.includes('במתחם') ? 'y' : 'n' };
    }
    function currentStage() { return stageFor(createdAt || new Date()); }
    function totalFor(st) {
      const c = choice();
      if (!c) return null;
      return PRICES[c.lod][c.kind][st] + FOOD[c.kind] + (checkVals('wine') ? WINE : 0);
    }

    function renderPrices() {
      const st = currentStage();
      $('stageTag').textContent = STAGE_LABEL[st];
      $('stageTag').style.display = createdAt ? 'none' : '';
      const a = radioVal('attendance'), l = radioVal('lodging');
      const lod = l ? (l.includes('במתחם') ? 'y' : 'n') : 'y';
      const kinds = a ? [a.startsWith('סופ"ש מלא') ? 'full' : 'one'] : ['full', 'one'];
      const kindName = { full: 'סופ"ש מלא (2 לילות)', one: 'לילה אחד' };
      $('phead').innerHTML = `<tr><th>${createdAt ? 'המחיר שלך' : 'מחירי השלב הנוכחי'}</th><th>${lod === 'y' ? 'לינה במתחם' : 'לינה עצמאית'}</th></tr>`;
      $('ptab').innerHTML = kinds.map((k) =>
        `<tr><td>${kindName[k]}</td><td class="num">${fmt(PRICES[lod][k][st] + FOOD[k])}</td></tr>`).join('');

      const t = totalFor(st), c = choice();
      if (t == null) {
        $('total').className = 'total pending';
        $('total').textContent = 'בחרו מתי מגיעים ולינה כדי לראות את המחיר שלכם.';
        $('nextPrice').textContent = '';
        return;
      }
      $('total').className = 'total';
      $('total').textContent = 'סה"כ: ' + fmt(t);
      if (!createdAt && st < 2) {
        const now = PRICES[c.lod][c.kind][st] + FOOD[c.kind];
        const next = PRICES[c.lod][c.kind][st + 1] + FOOD[c.kind];
        const label = c.kind === 'full' ? 'הסופ"ש' : 'הלילה האחד';
        const wineNote = checkVals('wine') ? ' (לא כולל יין)' : '';
        $('nextPrice').textContent = `ב-${st === 0 ? '27.11' : '3.12'} המחיר של ${label}${wineNote} יעלה מ-${fmt(now)} ל-${fmt(next)}.`;
      } else {
        $('nextPrice').textContent = '';
      }
    }

    // ---------- פופ-אפ פתיחה ----------
    const fullDialog = $('fullDialog');
    function openFullModal() {
      if (fullDialog && fullDialog.showModal && !fullDialog.open) fullDialog.showModal();
    }

    $('waitClose')?.addEventListener('click', () => {
      fullDialog?.close();
      els.phone?.focus();
    });
    fullDialog?.addEventListener('click', (e) => { if (e.target === fullDialog) fullDialog.close(); });

    function toggle() {
      $('prevBox').hidden = radioVal('prev_retreats') !== 'כן';
      $('detailsBox').hidden = radioVal('workshop') !== 'כן' && radioVal('story') !== 'כן';
      renderPrices();
    }

    function fillForm(r) {
      TEXT.forEach((k) => { $(k).value = r[k] ?? ''; });
      RADIOS.forEach((k) => document.querySelectorAll(`input[name="${k}"]`).forEach((i) => { i.checked = i.value === String(r[k] ?? ''); }));
      CHECKS.forEach((k) => {
        const vals = String(r[k] ?? '').split(',').map((s) => s.trim()).filter(Boolean);
        document.querySelectorAll(`input[name="${k}"]`).forEach((i) => { i.checked = vals.includes(i.value); });
      });
      createdAt = r.created ? new Date(r.created) : null;
      toggle();
    }

    function resetState() {
      els.form.reset();
      loadedPhone = ''; createdAt = null;
      els.saveBtn.textContent = 'שמירת ההרשמה';
      els.deleteBtn.hidden = true;
      $('buySec').hidden = true;
      $('statsBtn').hidden = true;
      toggle();
    }

    async function loadExisting(silent) {
      const phone = normPhone(els.phone.value);
      if (!validPhone(phone)) { if (!silent) setMsg(els.loadMsg, 'הזינו מספר טלפון תקין, למשל 0501234567.'); return; }
      setMsg(els.loadMsg, 'מחפשים הרשמה קיימת…');
      if (els.refreshBtn) els.refreshBtn.disabled = true;
      try {
        const res = await jsonp({ action: 'get', phone });
        if (!res.ok) throw new Error(res.error);
        loadedPhone = phone;
        $('statsBtn').hidden = !res.owner;
        if (res.found) {
          fillForm(res.data);
          els.saveBtn.textContent = 'עדכון ההרשמה';
          els.deleteBtn.hidden = false;
          setMsg(els.loadMsg, 'הפרטים נטענו. אפשר לשנות ולעדכן.');
          $('buySec').hidden = !res.buyer;
          if (res.buyer) renderPurchases(res.purchases || []);
        } else {
          createdAt = null;
          els.saveBtn.textContent = 'שמירת ההרשמה';
          els.deleteBtn.hidden = true;
          $('buySec').hidden = true;
          setMsg(els.loadMsg, 'אין עדיין הרשמה עם המספר הזה. ממלאים ושומרים.');
          toggle();
        }
      } catch (e) {
        setMsg(els.loadMsg, 'הטעינה נכשלה. בדקו את החיבור ונסו שוב.');
      } finally {
        if (els.refreshBtn) els.refreshBtn.disabled = false;
      }
    }

    els.refreshBtn?.addEventListener('click', () => loadExisting(false));
    els.phone.addEventListener('blur', () => {
      const p = normPhone(els.phone.value);
      if (validPhone(p) && p !== loadedPhone) loadExisting(true);
    });
    els.phone.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); els.phone.blur(); } });
    els.form.addEventListener('change', toggle);

    els.form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const phone = normPhone(els.phone.value);
      const fail = (msg, el) => { setMsg(els.saveMsg, msg, 'err'); if (el) { el.focus(); el.scrollIntoView({ block: 'center', behavior: 'smooth' }); } };
      if (!validPhone(phone)) return fail('מספר הטלפון לא תקין.', els.phone);

      const data = { phone };
      TEXT.forEach((k) => { data[k] = $(k).value.trim(); });
      RADIOS.forEach((k) => { data[k] = radioVal(k); });
      CHECKS.forEach((k) => { data[k] = checkVals(k); });

      if (!data.name) return fail('חסר שם מלא.', $('name'));
      if (!/[\u0590-\u05FF]/.test(data.name)) return fail('כתבו את השם המלא בעברית.', $('name'));
      if (data.name.split(/\s+/).length < 2) return fail('כתבו שם פרטי ושם משפחה.', $('name'));
      if (data.email && !validEmail(data.email)) return fail('כתובת המייל לא תקינה.', $('email'));
      if (!data.attendance) return fail('בחרו מתי מגיעים.', document.querySelector('input[name="attendance"]'));
      if (!data.lodging) return fail('בחרו סוג לינה.', document.querySelector('input[name="lodging"]'));
      if (!validAge(data.age)) return fail('הגיל צריך להיות בין 18 ל‑99.', $('age'));
      if (!data.why) return fail('ספרו בקצרה למה תרצו להצטרף לריטריט.', $('why'));
      if (data.prev_retreats !== 'כן') data.prev_feedback = '';
      if (data.workshop !== 'כן' && data.story !== 'כן') data.content_details = '';

      els.saveBtn.disabled = true;
      setMsg(els.saveMsg, 'שומרים…');
      try {
        const res = await post({ action: 'save', data });
        if (!res.ok) throw new Error(res.error);
        try { localStorage.setItem(LS_KEY, phone); } catch {}
        loadedPhone = phone;
        createdAt = new Date(res.created);
        renderPrices();
        els.saveBtn.textContent = 'עדכון ההרשמה';
        els.deleteBtn.hidden = false;
        setMsg(els.saveMsg, (res.isNew ? 'ההרשמה נשמרה.' : 'ההרשמה עודכנה.') + ' אפשר לחזור ולעדכן בכל זמן עם אותו מספר טלפון.', 'ok');
        showDone(res.total);
      } catch (err) {
        setMsg(els.saveMsg, 'השמירה נכשלה: ' + errText(err), 'err');
      } finally {
        els.saveBtn.disabled = false;
      }
    });

    els.deleteBtn.addEventListener('click', async () => {
      const phone = normPhone(els.phone.value);
      if (!validPhone(phone)) return setMsg(els.saveMsg, 'מספר הטלפון לא תקין.', 'err');
      if (!confirm('למחוק את ההרשמה שלכם? כל הפרטים יימחקו.')) return;
      els.deleteBtn.disabled = true; els.saveBtn.disabled = true;
      setMsg(els.saveMsg, 'מוחקים…');
      try {
        const res = await jsonp({ action: 'delete', phone });
        if (!res.ok) throw new Error(res.error);
        try { localStorage.removeItem(LS_KEY); } catch {}
        resetState();
        setMsg(els.loadMsg, '');
        setMsg(els.saveMsg, res.status === 'deleted'
          ? 'ההרשמה נמחקה. אם תשנו את דעתכם, אפשר להירשם מחדש בכל זמן.' : 'לא נמצאה הרשמה עם המספר הזה.', 'ok');
      } catch (err) {
        setMsg(els.saveMsg, 'המחיקה נכשלה: ' + errText(err), 'err');
      } finally {
        els.deleteBtn.disabled = false; els.saveBtn.disabled = false;
      }
    });

    // ---------- דיווח קניות ----------
    function renderPurchases(list) {
      $('buyList').innerHTML = list.map((p) => {
        const d = p.created ? new Date(p.created).toLocaleDateString('he-IL', { day: '2-digit', month: '2-digit' }) : '';
        return `<li><span>${esc(d)}${p.store ? ' · ' + esc(p.store) : ''}${p.details ? ' – ' + esc(p.details) : ''}</span><span class="amt">${fmt(p.amount)}</span></li>`;
      }).join('');
      const sum = list.reduce((s, p) => s + (+p.amount || 0), 0);
      $('buyTotal').textContent = list.length ? 'סה"כ קניות שדווחו: ' + fmt(Math.round(sum * 100) / 100) : '';
    }

    async function fileToPayload(f) {
      if (f.type.startsWith('image/')) {
        try {
          const img = await createImageBitmap(f);
          const s = Math.min(1, 1600 / Math.max(img.width, img.height));
          const c = document.createElement('canvas');
          c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          const url = c.toDataURL('image/jpeg', 0.75);
          return { name: f.name.replace(/\.[^.]+$/, '') + '.jpg', mime: 'image/jpeg', b64: url.split(',')[1] };
        } catch {}
      }
      if (f.size > 8 * 1024 * 1024) throw new Error('הקובץ גדול מדי (עד 8MB).');
      const url = await new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(f); });
      return { name: f.name, mime: f.type || 'application/octet-stream', b64: String(url).split(',')[1] };
    }

    $('b_file').addEventListener('change', (e) => {
      const f = e.target.files[0];
      $('b_fileName').textContent = f ? 'קבלה צורפה: ' + f.name : 'צילום או העלאת קבלה';
    });

    $('buyBtn').addEventListener('click', async () => {
      const phone = normPhone(els.phone.value);
      const amount = parseFloat($('b_amount').value.replace(/[^\d.]/g, ''));
      if (!(amount > 0)) { setMsg($('buyMsg'), 'הזינו סכום.', 'err'); $('b_amount').focus(); return; }
      $('buyBtn').disabled = true;
      setMsg($('buyMsg'), 'שומרים…');
      try {
        const f = $('b_file').files[0];
        const file = f ? await fileToPayload(f) : null;
        const res = await post({ action: 'purchase', phone, amount, store: $('b_store').value.trim(), details: $('b_details').value.trim(), file }, 60000);
        if (!res.ok) throw new Error(res.error === 'not a buyer' ? 'החלק הזה פתוח רק לצוות הקניות.' : res.error);
        renderPurchases(res.purchases || []);
        ['b_amount', 'b_store', 'b_details', 'b_file'].forEach((id) => { $(id).value = ''; });
        $('b_fileName').textContent = 'צילום או העלאת קבלה';
        setMsg($('buyMsg'), 'הקנייה נשמרה. אפשר להוסיף קנייה נוספת.', 'ok');
      } catch (err) {
        setMsg($('buyMsg'), 'השמירה נכשלה: ' + errText(err), 'err');
      } finally {
        $('buyBtn').disabled = false;
      }
    });

    const doneDialog = $('doneDialog');
    function showDone(total) {
      $('doneNote').textContent = 'הרשמה אינה מהווה אישור השתתפות.';
      $('donePrice').innerHTML = total ? 'סה"כ לתשלום: <b>' + fmt(total) + '</b>' : '';
      if (doneDialog.showModal) doneDialog.showModal(); else alert('תודה, הפרטים התקבלו.');
    }
    $('doneClose').addEventListener('click', () => doneDialog.close());
    doneDialog.addEventListener('click', (e) => { if (e.target === doneDialog) doneDialog.close(); });

    // ---------- init ----------
    toggle();
    try {
      const saved = localStorage.getItem(LS_KEY);
      if (saved) {
        els.phone.value = saved;
        loadExisting(true);
      }
    } catch {}
    openFullModal();
  </script>
</body>
</html>