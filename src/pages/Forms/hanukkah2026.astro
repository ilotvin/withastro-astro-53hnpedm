---
// hanukkah2026.astro
// ריטריט חנוכה 2026 – מנגנים שרים ביחד, מצפה רמון – הרשמה ועדכון לפי טלפון

// ===== גרסה – להעלות ב-1 בכל עדכון =====
const VERSION = 'V16';
// =========================================

// תאריך ושעת העדכון נקבעים אוטומטית ברגע ה-deploy (שעון ישראל)
const UPDATED = new Intl.DateTimeFormat('he-IL', {
  timeZone: 'Asia/Jerusalem', day: '2-digit', month: '2-digit', year: '2-digit',
  hour: '2-digit', minute: '2-digit', hour12: false
}).format(new Date()).replace(',', '');
---
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#A35A32" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500&display=swap" rel="stylesheet" />
  <title>מנגנים שרים ביחד – ריטריט חנוכה במצפה רמון</title>
  <meta property="og:title" content="מנגנים שרים ביחד – ריטריט חנוכה במצפה רמון" />
  <meta property="og:description" content="10–12 לדצמבר 26 · שלושה ימים של ג'אמים, סדנאות ומדורה מול המכתש. נרשמים ומעדכנים מתי שרוצים." />
  <meta property="og:image" content="https://atroproject1.vercel.app/images/hanukkah2026.jpg" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1600" />
  <meta property="og:image:height" content="900" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://atroproject1.vercel.app/Forms/hanukkah2026" />
  <style is:global>
    :root {
      --bg: #8A4B2A; --surface: #6E3A1F; --ink: #FFFFFF; --muted: #F3D9BF; --line: #A9683F;
      --sage: #F6C453; --sage-ink: #2A1A00; --gold: #FFB38A; --gold-soft: #5E3018; --danger: #FFD0C8;
      --field: #9A5733;
      --font: Arial, "Helvetica Neue", Helvetica, sans-serif;
      color-scheme: dark;
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    body { margin: 0; min-height: 100vh; background: linear-gradient(180deg, #A35A32 0, #8A4B2A 520px, #6E3A1F 100%) fixed; background-color: var(--bg); color: var(--ink); font-family: var(--font); font-size: 17px; line-height: 1.6; }
    .wrap { max-width: 640px; margin: 0 auto; padding: 0 20px 64px; position: relative; }
    .version { position: absolute; top: 10px; left: 20px; font-size: 11px; color: var(--muted); opacity: .55; letter-spacing: .04em; font-variant-numeric: tabular-nums; }
    h1, h2 { font-family: var(--font); font-weight: 700; line-height: 1.1; margin: 0; }
    h1 { font-size: clamp(38px, 10vw, 60px); letter-spacing: -0.01em; }
    h2 { font-size: 30px; }
    .muted { color: var(--muted); }
    .req { color: var(--gold); font-weight: 700; }
    .hero { padding: 48px 0 32px; text-align: center; }
    .subtitle { font-weight: 700; font-size: clamp(21px, 5vw, 28px); line-height: 1.25; margin: 10px 0 0; color: var(--sage); }
    .event-date { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 14px 0 0; font-family: "Frank Ruhl Libre", serif; font-size: 18px; letter-spacing: .12em; color: var(--muted); }
    .event-date .sep { width: 28px; height: 1px; background: var(--sage); opacity: .8; }
    .event-place { margin: 6px 0 0; font-size: 16px; }
    .stage { display: inline-block; margin-top: 16px; padding: 6px 16px; border-radius: 999px; background: var(--sage); color: var(--sage-ink); font-weight: 700; font-size: 15px; }
    .cover { width: 80%; margin: 20px auto 0; border-radius: 14px; overflow: hidden; background: var(--surface); }
    .cover img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block; }
    .cover.is-empty { aspect-ratio: 16 / 9; display: grid; place-items: center; border: 2px dashed var(--line); background: transparent; }
    .cover.is-empty::after { content: "כאן תופיע תמונה"; color: var(--muted); font-size: 16px; }
    .btn { display: inline-block; font: inherit; font-weight: 700; padding: 12px 22px; border-radius: 999px; border: 2px solid var(--sage); background: transparent; color: var(--ink); text-decoration: none; cursor: pointer; }
    .btn-primary { background: var(--sage); color: var(--sage-ink); }
    .btn-danger { border-color: var(--danger); color: var(--danger); }
    .btn-small { padding: 8px 16px; font-size: 15px; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
    .btn:disabled { opacity: .55; cursor: progress; }
    :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
    .join { padding-top: 40px; border-top: 1px solid var(--line); }
    .join > p { margin: 8px 0 20px; }
    .field { margin-bottom: 18px; }
    .field > label, .q { display: block; font-weight: 700; margin-bottom: 6px; }
    input[type=text], input[type=tel], input[type=number], input[type=email], textarea { width: 100%; font: inherit; color: var(--ink); background: var(--field); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
    input[dir=ltr] { text-align: left; }
    input[dir=ltr]:placeholder-shown { direction: rtl; text-align: right; }
    input[type=number] { max-width: 8em; }
    textarea { min-height: 80px; resize: vertical; }
    input::placeholder, textarea::placeholder { color: var(--muted); }
    .hint { font-size: 15px; color: var(--muted); margin: 6px 0 0; }
    fieldset { border: 0; padding: 0; margin: 0; }
    .group { padding: 16px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); margin-bottom: 18px; }
    .group > legend { font-size: 19px; font-weight: 700; margin: 0 0 10px; float: right; width: 100%; }
    .legend-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .group > legend + * { clear: both; }
    .group-intro { font-size: 16px; color: var(--muted); margin: 0 0 16px; }
    .modes { display: grid; gap: 8px; }
    .modes label { display: flex; gap: 10px; align-items: center; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); cursor: pointer; font-weight: 400; }
    .modes label:has(input:checked) { border-color: var(--sage); box-shadow: inset 0 0 0 1px var(--sage); }
    .modes input { margin: 0; accent-color: var(--sage); flex: none; width: 18px; height: 18px; }
    .modes.inline { grid-template-columns: repeat(2, 1fr); max-width: 18em; }
    .modes.inline.three { grid-template-columns: repeat(3, 1fr); max-width: 26em; }
    .modes.inline label { justify-content: center; }
    .modes.chips { display: flex; flex-wrap: wrap; }
    .modes.chips label { padding: 8px 12px; font-size: 16px; }
    .role span small { display: block; font-size: 14px; color: var(--muted); margin-top: 2px; }
    .role { align-items: flex-start !important; }
    .role input { margin-top: 3px; }
    .t-price { margin-inline-start: auto; color: var(--sage); white-space: nowrap; font-weight: 700; }
    .info { margin: 12px 0 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); font-size: 16px; }
    .info p { margin: 0 0 4px; }
    .info p:last-child { margin: 0; }
    .star { font-size: 15px; color: var(--muted); margin: 10px 0 0; }
    .star b { color: var(--gold); }
    .summary { border: 2px solid var(--sage); }
    .ptable { width: 100%; border-collapse: collapse; font-size: 16px; margin-bottom: 10px; }
    .ptable th, .ptable td { padding: 8px 4px; border-bottom: 1px solid var(--line); text-align: right; font-weight: 400; }
    .ptable th { color: var(--muted); font-size: 14px; }
    .ptable td.num { color: var(--sage); font-weight: 700; font-variant-numeric: tabular-nums; }
    .total { font-size: 26px; font-weight: 700; margin: 12px 0 2px; font-variant-numeric: tabular-nums; }
    .total.pending { font-size: 16px; font-weight: 400; color: var(--muted); }
    .buy { border: 2px dashed var(--sage); }
    .buy-card { padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
    .buy-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 0 12px; }
    .upload { display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px dashed var(--line); border-radius: 10px; cursor: pointer; color: var(--muted); }
    .upload input { display: none; }
    .buy-list { list-style: none; padding: 0; margin: 14px 0 0; }
    .buy-list li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
    .buy-list .amt { color: var(--sage); font-weight: 700; white-space: nowrap; }
    .buy-total { font-weight: 700; margin-top: 10px; }
    .msg { margin: 12px 0 0; min-height: 1.6em; }
    .msg.ok { color: var(--sage); }
    .msg.err { color: var(--danger); }
    .done { width: min(92vw, 440px); padding: 28px 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--ink); text-align: center; font-family: var(--font); }
    .done::backdrop { background: rgba(40, 18, 6, .75); }
    .done-logo { font-family: "Frank Ruhl Libre", serif; color: var(--sage); line-height: 1.05; margin-bottom: 16px; }
    .done-logo .l1 { display: block; font-size: 20px; font-weight: 500; letter-spacing: .06em; }
    .done-logo .l2 { display: flex; align-items: center; gap: 8px; justify-content: center; font-size: 14px; letter-spacing: .3em; margin-top: 3px; }
    .done-logo .l2::before, .done-logo .l2::after { content: ""; width: 18px; height: 1px; background: currentColor; opacity: .7; }
    .done h2 { font-size: 26px; margin: 0 0 6px; }
    .done-note { font-size: 15px; color: var(--muted); margin: 0 0 18px; }
    .done-info { border-top: 1px solid var(--line); padding-top: 16px; margin-bottom: 22px; }
    .done-date { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 10px; }
    .done-date b { display: block; font-size: 24px; color: var(--sage); }
    .done-date span { display: block; font-size: 15px; color: var(--muted); }
    .done-price { font-size: 17px; margin: 14px 0 0; }
    .done-price b { color: var(--sage); }
    .done-pay { font-size: 14px; color: var(--muted); margin: 4px 0 0; }
    .full-modal { text-align: right; max-height: 90vh; overflow-y: auto; }
    .retreat-header { text-align: center; margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
    .retreat-header .r-title { font-size: 22px; font-weight: 700; color: var(--sage); line-height: 1.2; }
    .retreat-header .r-sub { font-size: 15px; color: var(--muted); margin-top: 4px; }
    .full-modal .lead { font-size: 16px; margin: 0 0 14px; text-align: right; color: var(--ink); line-height: 1.65; white-space: pre-line; }
    .full-modal .actions { justify-content: center; margin-top: 16px; }
    .about { margin-top: 32px; padding: 20px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; font-size: 16px; line-height: 1.7; }
    .about h3 { margin: 0 0 6px; font-size: 20px; color: var(--sage); }
    .about p { margin: 0 0 10px; }
    .community { margin-top: 20px; font-size: 0.9em; color: var(--muted); }
    .community p { margin: 0 0 10px; }
    .community a { color: var(--sage); font-weight: 700; }
    @media (max-width: 600px) { .cover { width: 100%; } }
    @media (max-width: 420px) { .buy-grid { grid-template-columns: 1fr; } .modes.inline.three { grid-template-columns: 1fr 1fr 1fr; } }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="version" dir="ltr">{VERSION} · {UPDATED}</div>
    <header class="hero">
      <h1>מנגנים שרים ביחד</h1>
      <p class="subtitle">ריטריט חנוכה</p>
      <p class="event-date"><span>10–12 לדצמבר 26</span><span class="sep" aria-hidden="true"></span><span>חמישי–שבת</span></p>
      <p class="event-place">מתחם פעימה, מצפה רמון</p>
      <figure class="cover">
        <img src="/images/hanukkah2026.jpg" alt="ריטריט חנוכה במצפה רמון" onerror="this.parentElement.classList.add('is-empty'); this.remove();" />
      </figure>
      <span class="stage" id="stageTag"></span>
    </header>

    <main>
      <section class="join" aria-labelledby="join-title">
        <h2 id="join-title">הרשמה ועדכון</h2>
        <p class="muted">מספר הטלפון הוא המזהה שלכם. נרשמתם כבר? הזינו אותו, והפרטים שלכם ייטענו אוטומטית לעדכון.<br />שדות עם <span class="req">*</span> הם חובה, כל השאר לפי רצונכם.</p>

        <form id="form" novalidate>
          <!-- 1. פרטים -->
          <fieldset class="group">
            <legend>
              <span class="legend-row">
                <span>פרטים</span>
                <button type="button" id="refreshBtn" class="btn btn-small">רענן פרטים</button>
              </span>
            </legend>
            <div class="field">
              <label for="phone">מספר טלפון <span class="req">*</span></label>
              <input id="phone" type="tel" inputmode="numeric" autocomplete="tel" placeholder="050-0000000" />
              <p id="loadMsg" class="hint"></p>
            </div>
            <div class="field">
              <label for="name">שם מלא בעברית <span class="req">*</span></label>
              <input id="name" type="text" autocomplete="name" maxlength="80" />
            </div>
            <div class="field" style="margin-bottom:0">
              <label for="email">כתובת מייל</label>
              <input id="email" type="email" dir="ltr" autocomplete="email" maxlength="120" placeholder="name@gmail.com" />
            </div>
          </fieldset>

          <!-- 2. מתי מגיעים -->
          <fieldset class="group">
            <legend>מתי מגיעים? <span class="req">*</span></legend>
            <div class="modes">
              <label><input type="radio" name="attendance" value='סופ"ש מלא (חמישי–שבת)' /><span>סופ"ש מלא (חמישי–שבת)</span></label>
              <label><input type="radio" name="attendance" value="שישי–שבת" /><span>שישי–שבת</span></label>
              <label><input type="radio" name="attendance" value="חמישי–שישי" /><span>חמישי–שישי</span></label>
            </div>
            <div class="field" style="margin:16px 0">
              <span class="q">האם תתעניינו להישאר עוד לילה (שבת–ראשון)?</span>
              <div class="modes inline three">
                <label><input type="radio" name="extra_night" value="כן" /><span>כן</span></label>
                <label><input type="radio" name="extra_night" value="אולי" /><span>אולי</span></label>
                <label><input type="radio" name="extra_night" value="לא" /><span>לא</span></label>
              </div>
            </div>
            <span class="q">לינה <span class="req">*</span></span>
            <div class="modes">
              <label><input type="radio" name="lodging" value="לינה במתחם (מזרנים על פרקט)" /><span>לינה במתחם (מזרנים על פרקט)</span></label>
              <label><input type="radio" name="lodging" value="לינה עצמאית (מלון / B&B)" /><span>לינה עצמאית (מלון / B&amp;B)</span></label>
            </div>
          </fieldset>

          <!-- 3. קצת עליכם -->
          <fieldset class="group">
            <legend>קצת עליכם</legend>
            <div class="field">
              <label for="age">גיל <span class="req">*</span></label>
              <input id="age" type="number" inputmode="numeric" min="18" max="99" />
            </div>
            <div class="field">
              <span class="q">מי אני?</span>
              <div class="modes inline">
                <label><input type="radio" name="gender" value="גבר" /><span>גבר</span></label>
                <label><input type="radio" name="gender" value="אישה" /><span>אישה</span></label>
              </div>
            </div>
            <div class="field">
              <label for="why">למה את/ה רוצה להצטרף לריטריט? <span class="req">*</span></label>
              <textarea id="why" maxlength="600"></textarea>
            </div>
            <div class="field">
              <span class="q">האם יצא לך להיות בריטריטים בעבר?</span>
              <div class="modes inline">
                <label><input type="radio" name="prev_retreats" value="כן" /><span>כן</span></label>
                <label><input type="radio" name="prev_retreats" value="לא" /><span>לא</span></label>
              </div>
            </div>
            <div class="field" id="prevBox" hidden>
              <label for="prev_feedback">מה אהבת ומה פחות התחברת?</label>
              <textarea id="prev_feedback" maxlength="600"></textarea>
            </div>
            <div class="field" style="margin-bottom:0">
              <label for="social">קישור לרשת חברתית (מומלץ)</label>
              <input id="social" type="text" dir="ltr" inputmode="url" maxlength="200" placeholder="מומלץ למלא סושיאל" />
            </div>
          </fieldset>

          <!-- 4. הגעה -->
          <fieldset class="group">
            <legend>הגעה <span class="muted" style="font-weight:400;font-size:15px">(ניתן לעדכן בהמשך)</span></legend>
            <div class="modes">
              <label><input type="radio" name="car" value="נוהג" /><span>נוהג</span></label>
              <label><input type="radio" name="car" value="נוהג, יכול לקחת טרמפ" /><span>נוהג, יכול לקחת טרמפ</span></label>
              <label><input type="radio" name="car" value="מחפש טרמפ" /><span>מחפש טרמפ</span></label>
            </div>
            <div class="field" style="margin:16px 0 0">
              <label for="area">מאיזה אזור יוצאים?</label>
              <input id="area" type="text" maxlength="60" placeholder="תל אביב" />
            </div>
          </fieldset>

          <!-- 5. אוכל ושתייה -->
          <fieldset class="group">
            <legend>אוכל ושתייה</legend>
            <div class="modes">
              <label><input type="checkbox" name="wine" value="כן" /><span>מעוניין/ת להשתתף במסלול יין</span><b class="t-price">90 ₪</b></label>
            </div>
            <div class="info">
              <p><b>הסופ"ש כולל ארוחות בוקר, צהריים וערב.</b></p>
              <p>במתחם מטבח גדול ומאובזר, וניתן להכין בו מה שרוצים (לא בזמני הארוחות).</p>
              <p>במטבח יש פינת קפה וחלב חופשי.</p>
            </div>
            <div class="field" style="margin:16px 0 0">
              <label for="baking">רוצים להוביל אפייה? הציעו רעיונות ומצרכים</label>
              <textarea id="baking" maxlength="500" placeholder="סופגניות, לביבות, עוגת שמרים..."></textarea>
            </div>
          </fieldset>

          <!-- 6. תוכן -->
          <fieldset class="group">
            <legend>תוכן</legend>
            <div class="field">
              <label for="two_facts">שתפו שתי עובדות מעניינות על עצמכם</label>
              <textarea id="two_facts" maxlength="500"></textarea>
            </div>
            <div class="field">
              <span class="q">באילו פעילויות תרצו להשתתף? <span class="muted" style="font-weight:400;font-size:15px">(בחירה מרובה)</span></span>
              <div class="modes chips">
                <label><input type="checkbox" name="activities" value="שיעור ריקוד" /><span>שיעור ריקוד (למידת טכניקה)</span></label>
                <label><input type="checkbox" name="activities" value="יוגה" /><span>תרגול יוגה</span></label>
                <label><input type="checkbox" name="activities" value="אקרו-יוגה" /><span>אקרו-יוגה</span></label>
                <label><input type="checkbox" name="activities" value="ציור" /><span>שיעור ציור</span></label>
                <label><input type="checkbox" name="activities" value="אימפרוביזציה" /><span>סדנת אימפרוביזציה</span></label>
                <label><input type="checkbox" name="activities" value="מסלול הליכה" /><span>מסלול הליכה</span></label>
              </div>
            </div>
            <div class="field">
              <label for="connect_ideas">יש לכם רעיונות לפעילויות מחברות? נשמח לשמוע</label>
              <textarea id="connect_ideas" maxlength="500" placeholder="משחק היכרות, מעגל שיתוף, ערב משחקי קופסה..."></textarea>
            </div>
            <div class="field">
              <span class="q">רוצים להעביר סדנה?</span>
              <div class="modes inline">
                <label><input type="radio" name="workshop" value="כן" /><span>כן</span></label>
                <label><input type="radio" name="workshop" value="לא" /><span>לא</span></label>
              </div>
            </div>
            <div class="field">
              <span class="q">פינת השראה: רוצים לשתף סיפור?</span>
              <div class="modes inline">
