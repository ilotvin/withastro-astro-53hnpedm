---
// src/pages/Rosh_shana.astro  →  זמין בכתובת /Rosh_shana
const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzx06YrmfzAo-ocEw19JSUv5HFnnZwys-NOJ8eexC169xjRtlYXfg5eMAI9adW2Ctf0/exec";

// כתובת הבסיס של האתר — נדרשת לתצוגה המקדימה בוואטסאפ
const SITE = "https://atroproject1.vercel.app";

// עדכנו את המספר בכל שינוי בטופס
const VERSION = "V6";
---

<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>שנה טובה — טופס הרשמה</title>
  <meta name="description" content="כמה פרטים קצרים כדי שנכיר לקראת האירוע" />

  <!-- תצוגה מקדימה בוואטסאפ / פייסבוק / טלגרם -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${SITE}/Rosh_shana`} />
  <meta property="og:title" content="שנה טובה — טופס הרשמה" />
  <meta property="og:description" content="כמה פרטים קצרים כדי שנכיר לקראת האירוע" />
  <meta property="og:image" content={`${SITE}/images/rosh_shana.jpg`} />
  <meta property="og:image:secure_url" content={`${SITE}/images/rosh_shana.jpg`} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:alt" content="שנה טובה" />
  <meta property="og:locale" content="he_IL" />

  <!-- תצוגה מקדימה בטוויטר / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="שנה טובה — טופס הרשמה" />
  <meta name="twitter:description" content="כמה פרטים קצרים כדי שנכיר לקראת האירוע" />
  <meta name="twitter:image" content={`${SITE}/images/rosh_shana.jpg`} />

  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
      background: linear-gradient(160deg, #fff7ed 0%, #fde68a 45%, #fbcfe8 100%);
      background-attachment: fixed;
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 24px 16px;
    }
    .card {
      background: #fff;
      width: 100%;
      max-width: 480px;
      border-radius: 20px;
      box-shadow: 0 12px 44px rgba(180,83,9,.14);
      padding: 32px 24px 28px;
      overflow: hidden;
    }
    .version {
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      color: #d1b48c;
      letter-spacing: 1px;
      margin-bottom: 4px;
      direction: ltr;
    }
    h1 { margin: 0 0 6px; font-size: 26px; text-align: center; color: #7c2d12; }
    .sub { margin: 0 0 8px; text-align: center; color: #92785c; font-size: 14px; }

    .section {
      margin: 28px 0 18px;
      padding-bottom: 8px;
      border-bottom: 2px solid #fde68a;
      font-size: 13px;
      font-weight: 700;
      color: #b45309;
      letter-spacing: .5px;
    }
    .section .section-sub {
      display: block;
      font-weight: 400;
      color: #a8a29e;
      font-size: 12px;
      letter-spacing: 0;
      margin-top: 4px;
    }

    label { display: block; font-weight: 600; color: #44403c; margin-bottom: 6px; font-size: 15px; }
    .hint { font-weight: 400; color: #a8a29e; font-size: 13px; display: block; margin-top: 2px; }
    .req { color: #ef4444; margin-right: 3px; }

    input, select, textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid #e7e5e4;
      border-radius: 10px;
      font-size: 16px;
      font-family: inherit;
      margin-bottom: 18px;
      background: #fffdf8;
      transition: border-color .15s, box-shadow .15s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: #f59e0b;
      box-shadow: 0 0 0 3px rgba(245,158,11,.18);
    }
    input.ltr { direction: ltr; text-align: left; }
    textarea { resize: vertical; min-height: 100px; }

    .opts { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }

    label.opt {
      flex: 1 1 auto;
      min-width: 80px;
      position: relative;
      margin: 0;
      cursor: pointer;
    }
    label.opt input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
      margin: 0;
      padding: 0;
    }
    label.opt span {
      display: block;
      text-align: center;
      padding: 11px 14px;
      border: 1px solid #e7e5e4;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 400;
      color: #44403c;
      background: #fffdf8;
      transition: all .15s;
      user-select: none;
    }
    label.opt:hover span { background: #fffbeb; }
    label.opt input:checked + span {
      background: #fef3c7;
      border-color: #f59e0b;
      color: #92400e;
      font-weight: 600;
    }

    button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
      color: #fff;
      border: 0;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: filter .15s;
      margin-top: 10px;
    }
    button:hover:not(:disabled) { filter: brightness(1.08); }
    button:disabled { opacity: .55; cursor: not-allowed; }

    .msg { margin-top: 16px; padding: 12px; border-radius: 10px; font-size: 14px; text-align: center; }
    .err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

    .done { text-align: center; padding: 20px 0; }
    .check {
      width: 64px; height: 64px; margin: 0 auto 16px;
      background: #fef3c7; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 32px; color: #d97706;
    }
    .done h2 { margin: 0 0 8px; color: #7c2d12; }
    .done p { color: #92785c; font-size: 14px; margin: 0 0 20px; }
    .again { background: #f5f5f4; color: #44403c; }
    .again:hover:not(:disabled) { background: #e7e5e4; filter: none; }
    .hidden { display: none; }

    /* תמונה בראש הכרטיס */
    .header-img {
      margin: -32px -24px 22px;
      display: block;
      width: calc(100% + 48px);
      height: 170px;
      object-fit: cover;
      object-position: center 60%;
    }
  </style>
</head>

<body>
  <div class="card">

    <img src="/images/rosh_shana.jpg" alt="שנה טובה" class="header-img" />

    <div id="formView">
      <div class="version">{VERSION}</div>
      <h1>טופס הרשמה</h1>
      <p class="sub">מנגנים שרים ביחד -ערב ראש השנה</p>

      <div class="section">פרטים אישיים</div>

      <label for="name">שם מלא<span class="req">*</span></label>
      <input type="text" id="name" autocomplete="name" />

      <label for="phone">מספר טלפון<span class="req">*</span></label>
      <input type="tel" id="phone" class="ltr" inputmode="numeric"
             placeholder="050-123-4567" autocomplete="tel" />

      <label>מגדר</label>
      <div class="opts">
        <label class="opt"><input type="radio" name="gender" value="אישה" /><span>אישה</span></label>
        <label class="opt"><input type="radio" name="gender" value="גבר" /><span>גבר</span></label>
      </div>

      <label for="age">גיל</label>
      <input type="number" id="age" class="ltr" min="1" max="120" inputmode="numeric" />

      <label for="email">כתובת אימייל</label>
      <input type="email" id="email" class="ltr"
             placeholder="name@example.com" autocomplete="email" />

      <label for="social">לינק לסושיאל
        <span class="hint">פייסבוק, אינסטגרם או כל פרופיל אחר</span>
      </label>
      <input type="url" id="social" class="ltr" placeholder="https://..." />

      <div class="section">קצת עליך</div>

      <label for="about">כמה מילים על עצמך
        <span class="hint">ספר/י קצת על תחביבים, ומה הסיבה שאת/ה רוצה להצטרף לאירוע?</span>
      </label>
      <textarea id="about" placeholder="אפשר לכתוב בחופשיות..."></textarea>

      <label>מעוניין/ת להשתתף בארוחת ערב?</label>
      <div class="opts">
        <label class="opt"><input type="radio" name="dinner" value="כן" /><span>כן</span></label>
        <label class="opt"><input type="radio" name="dinner" value="לא" /><span>לא</span></label>
        <label class="opt"><input type="radio" name="dinner" value="עדיין לא בטוח" /><span>עדיין לא בטוח</span></label>
      </div>

      <button id="submitBtn">שליחה</button>
      <div id="err" class="msg err hidden"></div>
    </div>

    <div id="doneView" class="done hidden">
      <div class="check">✓</div>
      <h2>תודה רבה!</h2>
      <p>הפרטים שלך נקלטו בהצלחה.</p>
      <button class="again" id="againBtn">מילוי טופס נוסף</button>
    </div>

  </div>

  <script define:vars={{ SCRIPT_URL }}>
    const $ = (id) => document.getElementById(id);
    const btn = $("submitBtn");
    const errBox = $("err");

    const radioVal = (name) => {
      const el = document.querySelector(`input[name="${name}"]:checked`);
      return el ? el.value : "";
    };

    function showError(text) {
      errBox.textContent = text;
      errBox.classList.remove("hidden");
      errBox.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function clearError() {
      errBox.classList.add("hidden");
    }

    btn.addEventListener("click", async () => {
      clearError();

      const data = {
        name:   $("name").value.trim(),
        phone:  $("phone").value.trim(),
        gender: radioVal("gender"),
        age:    $("age").value.trim(),
        email:  $("email").value.trim(),
        social: $("social").value.trim(),
        about:  $("about").value.trim(),
        dinner: radioVal("dinner")
      };

      // חובה: שם מלא וטלפון בלבד
      if (!data.name || !data.phone) {
        showError("נא למלא שם מלא ומספר טלפון");
        return;
      }
      if (data.phone.replace(/\D/g, "").length < 9) {
        showError("מספר טלפון לא תקין");
        return;
      }
      // מייל אופציונלי — נבדק רק אם מולא
      if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
        showError("כתובת אימייל לא תקינה");
        return;
      }

      btn.disabled = true;
      btn.textContent = "שולח...";

      try {
        const params = new URLSearchParams(data);
        await fetch(`${SCRIPT_URL}?${params}`, {
          method: "GET",
          mode: "no-cors"
        });

        $("formView").classList.add("hidden");
        $("doneView").classList.remove("hidden");
        window.scrollTo({ top: 0, behavior: "smooth" });
      } catch (e) {
        showError("השליחה נכשלה. בדקו חיבור אינטרנט ונסו שוב.");
        btn.disabled = false;
        btn.textContent = "שליחה";
      }
    });

    $("againBtn").addEventListener("click", () => {
      ["name","phone","age","email","social","about"]
        .forEach(id => $(id).value = "");
      document.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
      btn.disabled = false;
      btn.textContent = "שליחה";
      $("doneView").classList.add("hidden");
      $("formView").classList.remove("hidden");
    });
  </script>
</body>
</html>